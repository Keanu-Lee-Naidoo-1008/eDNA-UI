                    <label id="lblSCStatus" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Last Warehoused By:
                    <label style="color:white;width:10px"></label>
                    <label id="lblSCWUser" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Last Warehoused Date:
                    <label id="lblSCWDate" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Last Allocated To:
                    <label style="color:white;width:30px"></label>
                    <label id="lblSCAUser" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Last Allocated Date:
                    <label style="color:white;width:18px"></label>
                    <label id="lblSCADate" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Assigned Recipient:
                    <label style="color:white;width:25px"></label>
                    <label id="lblSCTOUser" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Assigned Date:
                    <label style="color:white;width:25px"></label>
                    <label id="lblSCTODate" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Last Terminated By:
                    <label style="color:white;width:15px"></label>
                    <label id="lblSCTEUser" style="color:blue;height:10px"></label>
                </label>
                <label class="list-group-item" style="height:30px">
                    Last Terminated Date:
                    <label style="color:white;width:5px"></label>
                    <label id="lblSCTEDate" style="color:blue;height:10px"></label>
                </label>
                <a class="list-group-item" data-placement="bottom" data-toggle="tooltip"></a>
            </div>
        </div>
    </div>
    <label class="col-sm-1" style="color:white;width:18%"></label>
    <div class="col-sm-8" style="color:black">
        <table>
            <tr>
                <td>
                    <label id="lblTotal"></label>
                </td>
                <td>
                    &nbsp;
                </td>
                <td>
                    <label id="lblErrorTotal" style="color:red"></label>
                </td>
                <td>
                    &nbsp;
                </td>
                <td>
                    <label id="lblDuplicateTotal" style="color:red"></label>
                </td>
            </tr>
            <tr></tr>
        </table>
    </div>
</div>

@*CODESC: Form load events*@
<script type="text/javascript">
    $(document).ready(function ($) {
        //CODESC: Hide bulk import controls on form load
        $("#dvBulk").hide();
        $("#dvImport").hide();
        $("#lblGetStatus").hide();
        $("#chkGetStatus").hide();
        $("#lblGetStatus").hide();
        $("#divLoading").hide();
        $("#MVCSiteMap").show();
     
    });
</script>

@*CODESC: Form load event*@
<script type="text/javascript">
    $(window).on('load', function () {
        //CODESC: Get Smartcard lookups from data base.
        if ('@HttpContext.Current.Session["isSmartCardFormLoad"]' == 'True') {
            GetSmartcardLookUps('');
        }
    })
</script>

@*CODESC: Select the .csv file and populate the ListBox.*@
<script type="text/javascript">
    var l_lstSmartcardSLNos;
    var l_lblTotalCount;

    l_lstSmartcardSLNos = document.getElementById('lstSmartcardSLNos');
    l_lblTotalCount = document.getElementById('lblTotal');

    $(document).ready(function () {
        if (isAPIAvailable()) {
            $('#files').bind('change', UploadCSVFile);
        }
    });

    // CODESC:  for the various File API support.
    function isAPIAvailable() {
        if (window.File && window.FileReader && window.FileList && window.Blob) {
            // CODESC: Great success! All the File APIs are supported.
            return true;
        }
    }

    // CODESC: Read and populate the CSV content to the list box.
    function UploadCSVFile(evt) {
        var l_files = evt.target.files;
        var l_file = l_files[0];
        m_SCImportFileName = l_file.name;

        var l_Filereader = new FileReader();
        l_Filereader.readAsText(l_file);

        l_Filereader.onload = function (event) {
            var l_Split = event.target.result;
            var l_str_array = l_Split.split(',');
            for (var loop = 0; loop < l_str_array.length; loop++) {
                var tempOpt = new Option(l_str_array[loop], l_str_array[loop]);
                l_lstSmartcardSLNos.options.add(tempOpt);
            }
            l_lblTotalCount.innerText = "Total - " + l_lstSmartcardSLNos.childElementCount;
            m_WebMessageLogger.UserMessage("eDNA Message:- " + l_lstSmartcardSLNos.childElementCount + " - " + " Smartcards Imported Successfully", 'Black');

            //CODESC: Display Get status controls
            $("#chkGetStatus").show();
            $("#lblGetStatus").show();
        };
        m_WebMessageLogger.appendError("Unable to read " + l_file.fileName);
    }
</script>

@*CODESC: Clear Smartcard Information on selection*@
<script type="text/javascript">
    document.getElementById('lstSmartcardSLNos').onchange = function () {
        ClearSCInformation();
        if (this.selectedOptions.length === 1) QuerySmartCard();
    };
</script>

@*CODESC: Bind Smartcard serial list box control on Enter key press event.*@
<script type="text/javascript">
    $('#SerialNumber').keypress(function (event) {
        var keycode = (event.keyCode ? event.keyCode : event.which);
        if (keycode == '13') {
            event.preventDefault();
            BindListBox();
        }
    });
</script>

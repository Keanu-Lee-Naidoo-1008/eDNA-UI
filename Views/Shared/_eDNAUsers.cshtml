
<table class="table table-hover scroll" id="tblUserList">
    <thead style="background-color:steelblue;color:white">
        <tr>
            <th>eDNA ID</th>
            <th>Surname</th>
            <th>Name</th>
            <th>ID Number</th>
            <th>Select</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var eDNAUser in ((ViewBag.eDNAUsers as List<eDNA.WebPortal.Models.CUser>) ?? new List<eDNA.WebPortal.Models.CUser>()))
            {
            <tr style="font-size:medium">
                <td class="lalign" style="width:70px">@eDNAUser.UserId</td>
                <td class="lalign" style="width:150px">@eDNAUser.SurName</td>
                <td class="lalign" style="width:150px">@eDNAUser.Name</td>
                <td class="lalign" style="width:80px">@eDNAUser.IDNumber</td>
                <td class="lalign" style="width:40px">
                    <label><input id="optSelect" name="optSelect" type="radio" onchange="GetSeletedUser(@eDNAUser.UserId)" /></label>
                </td>
            </tr>
        }
        @if (((ViewBag.eDNAUsers as List<eDNA.WebPortal.Models.CUser>) ?? new List<eDNA.WebPortal.Models.CUser>()).Count == 0)
        {
            <tr class="ed-empty-row"><td colspan="5">@Html.Partial("_EmptyState", new ViewDataDictionary { { "EmptyHeading", "No users found" }, { "EmptyText", "No eDNA user matches that search." } })</td></tr>
        }
    </tbody>
    <tfoot style="border-style:groove"></tfoot>
</table>

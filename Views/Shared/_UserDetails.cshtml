@model eDNA.CommonData.Classes.CData_User
@* Shared fields only: the host owns the form, status dialog, navigation and signing. *@
@* Layout note: #dvUserInformation must contain exactly the inputs it always has (UserDetails/Index makes them read-only);
   User Status stays outside it. Rows in #dvUserAttributes keep their form-group / col-sm-* markup because rows added at
   runtime use the same markup; .ed-stacked-fields restyles both. *@
    <div class="panel-body-details ed-userform">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="ed-grid-2">
            <section class="ed-card">
                <div class="ed-card-header">
                    <h3>User Information</h3>
                </div>
                <div class="ed-card-body">
                    <div id="dvUserInformation">
                        <div class="ed-form-grid">
                            <div class="ed-field">
                                <label for="UserID">User ID</label>
                                @Html.TextBoxFor(model => model.UserID, new { @readonly = true, @class = "form-control", placeholder = "User ID" })
                            </div>
                            <div class="ed-field">
                                <label for="DateCreated">Created on</label>
                                @Html.TextBoxFor(model => model.DateCreated, new { @readonly = true, @class = "form-control", placeholder = "Created" })
                            </div>
                            <div class="ed-field ed-span-2">
                                <label for="EntityID">Entity</label>
                                @Html.DropDownListFor(model => model.EntityID, (SelectList)ViewBag.Entity, "[--Select An Entity--]", new { @class = "dropdown" })
                                @Html.ValidationMessageFor(model => model.EntityID, "", new { @class = "text-danger" })
                            </div>
                            <div class="ed-field">
                                <label for="FirstName">First name</label>
                                @Html.TextBoxFor(model => model.FirstName, new { @class = "form-control", placeholder = "First Name", autocomplete = "off" })
                                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                            </div>
                            <div class="ed-field">
                                <label for="Surname">Last name</label>
                                @Html.TextBoxFor(model => model.Surname, new { @class = "form-control", placeholder = "Last Name", autocomplete = "off" })
                                @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger" })
                            </div>
                            <div class="ed-field ed-field-inline ed-span-2">
                                @Html.CheckBoxFor(m => m.IsPassport)
                                <label for="IsPassport">Identification is a passport</label>
                            </div>
                            <div class="ed-field">
                                <label for="IDNumber">Identification number</label>
                                @Html.TextBoxFor(model => model.IDNumber, new { @maxlength = "13", @class = "form-control", placeholder = "ID Number", autocomplete = "off" })
                                @Html.ValidationMessageFor(model => model.IDNumber, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="ed-form-grid ed-userstatus">
                        <div class="ed-field">
                            <label for="UserStatus">User status</label>
                            @Html.TextBoxFor(model => model.UserStatus, new { @readonly = true, @class = "form-control", placeholder = "User Status", autocomplete = "off" })
                            @if ((bool)(ViewData["ShowStatusChange"] ?? false))
                            {
                            <a href="javascript:DisplayStatus()" id="lnkChangeStatus" data-toggle="tooltip" title="Change User Status" data-placement="bottom">Change Status</a>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <section class="ed-card">
                <div class="ed-card-header">
                    <h3>User Attributes</h3>
                </div>
                <div class="ed-card-body ed-stacked-fields">
                    <div id="dvUserAttributes">
                                        @foreach (var item in (Model.User_Attributes ?? new List<eDNA.CommonData.Classes.CData_User_Attribute>()))
                                        {

                                                <div class="form-group">
                                                    <label class="col-sm-4" for="@item.UserAttributeName">@item.UserAttributeType</label>
                                                    <div class="col-sm-7">
                                                        @if (item.UserAttributeControlID == 2)
                                                        {
                                                            @Html.DropDownList(item.UserAttributeName, new SelectList(item.DropDownNameAndList[@item.UserAttributeType], "Value"), item.UserAttribute, new { @class = "form-control", placeholder = @item.UserAttributeType })

                                                            if (item.RequiredField)
                                                            {
                                                                <script type="text/javascript">
                                                                          $('#@item.UserAttributeName').attr({
                                                                        'data-val' : true,
                                                                        'data-val-required' : '@item.UserAttributeType is Required'
                                                                    });
                                                                    $(document).ready(function () {
                                                                        $('#@item.UserAttributeName').val('@item.UserAttribute');
                                                                    });

                                                                </script>
                                                                <span class="text-danger field-validation-error" data-valmsg-for="@item.UserAttributeName" data-valmsg-replace="true"></span>
                                                            }
                                                        }
                                                        else
                                                        {

                                                            @Html.TextBox(item.UserAttributeName, item.UserAttribute, new { @class = "form-control input-validation-error", autocomplete = "off", placeholder = @item.UserAttributeType })

                                                            if (item.RequiredField)
                                                            {
                                                                <script type="text/javascript">
															var l_strRegexPattern = @Html.Raw(Json.Encode(item.Regex));

                                                                   $('#@item.UserAttributeName').attr({
                                                                    'data-val': true,
                                                                    'data-val-regex': '@item.UserAttributeType is not valid',
															'data-val-regex-pattern': l_strRegexPattern,
                                                                    'data-val-required' : '@item.UserAttributeType is Required'
                                                                });

                                                                </script>


                                                            }
                                                            <span class="text-danger field-validation-error" data-valmsg-for="@item.UserAttributeName" data-valmsg-replace="true"></span>
                                                        }
                                                    </div>
                                                </div>

                                        }
                        @if (!(Model.User_Attributes ?? new List<eDNA.CommonData.Classes.CData_User_Attribute>()).Any())
                        {
                            @Html.Partial("_EmptyState", new ViewDataDictionary { { "EmptyHeading", "No user attributes" }, { "EmptyText", "No extra attributes are set up for this user." } })
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>

@*CODESC: SessionTimeout Modal pop up.*@
<script type="text/javascript">
    function SessionTimeout() {
        if (m_EnrolmentTimeoutPaused) return;
        SwitchOnSessionTimer();
        $('#mdSessionTimeOut').modal('show');
        $("#cmdSessionTimeout").click(function () {
            m_SessionTimeOut = '';
            DoLogout();
            $(this).unbind();
        });
        //CODESC: Re-intialize the SessionTimeOut,if user clicks the Continue button.
        $("#cmdSessionContinue").click(function () {
            m_SessionTimeOut = m_SessionContinue + 1;
            PauseSessionTimer();
        });
    }
</script>

@*CODESC: Countdown for the session time out and auto log out the user from Web Portal.*@
<script type="text/javascript">
    var l_CountTime;
    var l_TimeOut, l_TimeLeft;
    var l_color = 'green';
    var l_clMagenta = 'magenta';
    var l_clOrangered = 'orangered';
    var l_clRed = 'red';
    var l_clGrey = 'grey';
    var l_clBlue = 'blue';

    //CODESC: SwitchOn/Off Timer
    function SwitchOnSessionTimer() {
        //CODESC: l_CountTime in seconds
        l_CountTime = 60;
        ResetSessionTimer();
    }

    //CODESC: Update display Time value
    function UpdateSessionDisplay(p_Color) {
        document.getElementById('timespan').innerHTML = l_TimeLeft;
        document.getElementById('timespan').style.color = p_Color;
    }

    //CODESC: Start Countdown and chnage the timer value color accordingly.
    function CountDownSessionTimeOut() {
        if (m_EnrolmentTimeoutPaused) { PauseSessionTimer(); return; }
        UpdateSessionDisplay(l_clBlue);
        if (l_TimeLeft >= 0) {
            if (l_TimeLeft > 55 && l_TimeLeft < 60) {
                UpdateSessionDisplay(l_clRed);
            }
            if (l_TimeLeft > 45 && l_TimeLeft < 50) {
                UpdateSessionDisplay(l_clOrangered);
            }
            if (l_TimeLeft > 35 && l_TimeLeft < 40) {
                UpdateSessionDisplay(l_clMagenta);
            }
            if (l_TimeLeft > 25 && l_TimeLeft < 30) {
                UpdateSessionDisplay(l_clBlue);
            }
            if (l_TimeLeft > 20 && l_TimeLeft < 25) {
                UpdateSessionDisplay(l_clGrey);
            }
            if (l_TimeLeft > 15 && l_TimeLeft < 20) {
                UpdateSessionDisplay(l_clRed);
            }
            if (l_TimeLeft > 10 && l_TimeLeft < 15) {
                UpdateSessionDisplay(l_clOrangered);
            }
            if (l_TimeLeft > 5 && l_TimeLeft < 10) {
                UpdateSessionDisplay(l_clMagenta);
            }
        }
        if (l_TimeLeft === 1) {
            DoLogout('True');
        }
        else {
            l_TimeLeft--;
            l_TimeOut = setTimeout(CountDownSessionTimeOut, 1000);
        }
    }

    //CODESC: Pauses Countdown
    function PauseSessionTimer() {
        clearTimeout(l_TimeOut);
    }

    //CODESC: Reset Countdown
    function ResetSessionTimer() {
        PauseSessionTimer();
        l_TimeLeft = l_CountTime;
        UpdateSessionDisplay(l_clBlue);
        CountDownSessionTimeOut();
    }
</script>

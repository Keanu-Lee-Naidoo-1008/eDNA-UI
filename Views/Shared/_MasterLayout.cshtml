            </div>
            <ol class="ed-steps" aria-label="Enrolment progress">
                @for (Int32 l_iStep = 1; l_iStep <= l_arEnrolmentSteps.Length; l_iStep++)
                {
                    String l_strStepState = l_iStep < l_iEnrolmentStep ? "is-done" : (l_iStep == l_iEnrolmentStep ? "is-current" : "");
                    <li class="ed-step @l_strStepState" @(l_iStep == l_iEnrolmentStep ? Html.Raw("aria-current=\"step\"") : null)>

        document.getElementById("Icon_Information").style.display = "none";
        //document.getElementById("UserEnromentWizard").style.display = "none";
    </script>

    @*CODESC: Change Default Finger.*@
    <script type="text/javascript">
        function ChangeDefaultFinger() {
            var l_arFingerIndexes = [];
            $.ajax({
                type: "POST",
                dataType: "json",
                traditional: true,
                url: "/eDNA.WebPortal/Logon/GetUserFingerIndexes",
                data: JSON.stringify({ "": "" }),
                contentType: "application/json; charset=utf-8",
                success: function (l_strFingerIndexes) {
                    if (l_strFingerIndexes != null && l_strFingerIndexes != "") {
                        l_arFingerIndexes = l_strFingerIndexes.split(',');

                        //CODESC: Highlight Registered and Default Finger.
                        HighlightRegisteredFingers(l_arFingerIndexes);
                    }
                },
                error: function (data) {
                    m_Logger.appendError(data);
                }
            });

            $('#mdChangeDefaultFinger').modal('show');

            //CODESC: Change Default Finger Color only if one the Registered finger is clicked.
            $("#lnkFinger1").click(function () {
                if ($.inArray('1', l_arFingerIndexes) != -1) {
                    l_arFingerIndexes[0] = 1;
                    HighlightRegisteredFingers(l_arFingerIndexes)
                }
            });
            $("#lnkFinger2").click(function () {
                if ($.inArray('2', l_arFingerIndexes) != -1) {
                    l_arFingerIndexes[0] = 2;
                    HighlightRegisteredFingers(l_arFingerIndexes)
                }
            });
            $("#lnkFinger3").click(function () {
                if ($.inArray('3', l_arFingerIndexes) != -1) {
                    l_arFingerIndexes[0] = 3;
                    HighlightRegisteredFingers(l_arFingerIndexes)
                }
            });
            $("#lnkFinger4").click(function () {
                if ($.inArray('4', l_arFingerIndexes) != -1) {
                    l_arFingerIndexes[0] = 4;
                    HighlightRegisteredFingers(l_arFingerIndexes)
                }
            });
            $("#lnkFinger5").click(function () {
                if ($.inArray('5', l_arFingerIndexes) != -1) {
                    l_arFingerIndexes[0] = 5;
                    HighlightRegisteredFingers(l_arFingerIndexes)
                }
            });
            $("#lnkFinger6").click(function () {
                if ($.inArray('6', l_arFingerIndexes) != -1) {
                    l_arFingerIndexes[0] = 6;
                    HighlightRegisteredFingers(l_arFingerIndexes)
                }
            });
            $("#lnkFinger7").click(function () {

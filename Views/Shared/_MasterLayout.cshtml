<!DOCTYPE html>
@{
    String l_strCurrentController = Convert.ToString(HttpContext.Current.Session["CurrentController"]);
    bool l_blEnrolmentPage = new[] { "UserEnrolment", "UserEnrolmentDetails", "BiometricEnrolment", "FaceEnrolment", "TransversalEnrolment", "PKIEnrolment" }
        .Any(controller => String.Equals(controller, l_strCurrentController, StringComparison.OrdinalIgnoreCase))
        || (String.Equals(l_strCurrentController, "TransversalManagement", StringComparison.OrdinalIgnoreCase)
            && (int)(ViewBag.ReturnToEnrolmentUserID ?? 0) > 0);

    // Presentation only: which step of the enrolment stepper is current (0 = not an enrolment page).
    String[] l_arEnrolmentSteps = { "User details", "Biometrics", "Transversal accounts", "PKI & smartcard" };
    Int32 l_iEnrolmentStep = 0;
    switch ((l_strCurrentController ?? "").ToLowerInvariant())
    {
        case "userenrolment":
        case "userenrolmentdetails": l_iEnrolmentStep = 1; break;
        case "biometricenrolment":
        case "faceenrolment": l_iEnrolmentStep = 2; break;
        case "transversalenrolment":
        case "transversalmanagement": l_iEnrolmentStep = 3; break;
        case "pkienrolment": l_iEnrolmentStep = 4; break;
    }
}
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - eDNA Web Portal</title>
    <link rel="icon" type="image/png" href="~/Content/Images/eDNA.png" />
    @Styles.Render("~/Content/css")
    @Html.Partial("_ModernTheme")
    @Scripts.Render("~/bundles/modernizr")
    <!-- Scripts -->

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @*CODESC: Start Web Socket Programming*@
    <script type="text/javascript">
       window.onload = function () {
          InitializeWebSocketClient('@l_strCurrentController');

          //CODESC: Hide controls dynamically
          var l_CurrentController = '@l_strCurrentController';
          if ((l_CurrentController == 'logon') || (l_CurrentController == 'Logon')){
              $("#dvHeaderMenu").hide();
              $("#dvSupport").hide();
              $("#dvCDFinger").show();
          }
          else{
              $("#dvCDFinger").hide();
              $("#dvHeaderMenu").show();
              $("#dvSupport").show();
          }
          if (l_CurrentController !='Home'){
             $("#eDNACarousel").hide();
           }
       };
    </script>

    @*CODESC: IF Session Time out, Logout the User from the eDNA Web Portal.*@
    <script type="text/javascript">
        //CODESC: Get the current controller from session.
        var l_CurrentController = '@l_strCurrentController';

        var m_EnrolmentTimeoutPaused = @(l_blEnrolmentPage ? "true" : "false");
        var m_EnrolmentKeepAlivePending = false;
        function KeepEnrolmentSessionAlive() {
            if (!m_EnrolmentTimeoutPaused || m_EnrolmentKeepAlivePending) return;
            m_EnrolmentKeepAlivePending = true;
            $.ajax({
                url: '@Url.Action("EnrolmentKeepAlive", "Base")',
                type: 'GET', dataType: 'json', cache: false, timeout: 15000,
                complete: function () { m_EnrolmentKeepAlivePending = false; }
            });
        }
        if (m_EnrolmentTimeoutPaused) {
            $(document).ready(KeepEnrolmentSessionAlive);
            window.addEventListener('pageshow', KeepEnrolmentSessionAlive);
        }
        //CODESC: Calculate the time interval.
        m_TimeInterval = setInterval('SessionWarning()', 60000);

        function SessionWarning() {
            if (m_EnrolmentTimeoutPaused) { KeepEnrolmentSessionAlive(); return; }
            m_SessionTimeOut--;
            if (m_SessionTimeOut <= 1) {
                if ((l_CurrentController == 'logon') || (l_CurrentController == 'Logon')) {
                }
                else {
                    SessionTimeout();
                }
            }
        }
    </script>
</head>

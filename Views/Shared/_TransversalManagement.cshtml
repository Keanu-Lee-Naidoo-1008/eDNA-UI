                success: function (p_ResponseTransversals) {
                    if (p_ResponseTransversals != null) {
                    }
                }
            });
        }
        else {
            $(e.target).closest("td").siblings("td"),
                l_UnSelectedTransversal = ($(e.target).closest("td").siblings("td")[0].innerHTML);
            m_arTransversalType.splice(m_arTransversalType.indexOf(l_UnSelectedTransversal), 1);

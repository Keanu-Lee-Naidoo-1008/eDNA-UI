<script type="text/javascript">
    var transversalActionPending = false;
    var transversalStateVersion = 0;
    function RefreshTransversalPrimary() {
        var version = ++transversalStateVersion;
        $.ajax({
            url: '@Url.Action("GetPrimaryAction", "TransversalManagement")',
            type: 'GET', cache: false, timeout: 15000,
            success: function (state) {
                if (version !== transversalStateVersion || transversalActionPending) return;
                $('#btnTransversalPrimary').text(state.Label).prop('disabled', !state.Ready);
            },
            error: function () {
                if (version !== transversalStateVersion || transversalActionPending) return;
                $('#btnTransversalPrimary').text('Retry').prop('disabled', false);
            }
        });
    }
    function TransversalPrimaryAction() {
        if (transversalActionPending) return;
        transversalActionPending = true;
        ++transversalStateVersion;
        $('#btnTransversalPrimary').prop('disabled', true);
        $.ajax({
            url: '@Url.Action("GetPrimaryAction", "TransversalManagement")',
            type: 'GET', cache: false, timeout: 15000,
            success: function (state) {
                if (!state.Ready) {
                    MessageBox('Transversal Management', 'Search for the user before continuing.', '', m_MessageType.Information);
                } else if (state.Changed) {
                    TransversalAccount_Manage('TM');
                } else {
                    location = state.Url;
                }
            },
            error: function () {
                MessageBox('Transversal Management', 'Could not check pending changes. Please try again.', '', m_MessageType.Error);
            },
            complete: function () {
                transversalActionPending = false;
                RefreshTransversalPrimary();
            }
        });
    }
    $(document).ready(RefreshTransversalPrimary);
    $(document).ajaxComplete(function (event, xhr, settings) {
        if (settings.url.indexOf('/TransversalManagement/') >= 0 &&
            settings.url.indexOf('GetPrimaryAction') < 0) RefreshTransversalPrimary();
    });
</script>

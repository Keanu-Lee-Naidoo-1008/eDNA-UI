<script type="text/javascript">
    var l_txteDNAID = document.getElementById("txteDNAID");
    var l_lblTransversalAction = document.getElementById("lblTransversalAction");
    $("#btnTransversalOK").click(function () {
        if (l_txteDNAID.value != "") {
            $.ajax({
                type: "POST",
                dataType: "json",
                traditional: true,
                url: "/eDNA.WebPortal/TransversalManagement/ValidateTranversalList",
                data: JSON.stringify({ 'p_strActionType': l_lblTransversalAction.innerHTML }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.success == true) {
                        if (response.ReponseData != null && response.ReponseData != "") {
                            var l_lstResponseData = response.ReponseData.split(',');
                            var l_strErrorTList = "";
                            for (i = 0; i < l_lstResponseData.length; i++) {
                                if (l_strErrorTList == "") {
                                    l_strErrorTList = l_lstResponseData[i] + '\r\n';
                                }
                                else {
                                    l_strErrorTList = l_strErrorTList + l_lstResponseData[i] + '\r\n';
                                }
                            }

                            MessageBox("Tranversal Management", "The following transversal(s) can not be " + l_lblTransversalAction.innerHTML, l_strErrorTList + '\r\n' + "Un-select the specific transversal and process again", m_MessageType.Error);
                        }
                        else {
                            //ToDo: NRS Transaction.
                        }
                    }
                }
            });
        }
    });
</script>


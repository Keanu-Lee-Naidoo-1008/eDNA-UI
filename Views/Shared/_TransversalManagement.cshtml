@*CODESC: Add transversal details to the Transversal table, add the values to the Transversal session object and close the pop up window.*@
<script type="text/javascript">
    $("#btnAddMTransversal").click(function () {
        var frmTransversalManage = $("#TransversalData");
        if (frmTransversalManage.valid()) {
            var l_txtTUserID = document.getElementById('TransversalSysUserID');
            var l_txtMainframeID = document.getElementById('TransversalParentUser');
            var l_BasInstalID = "";
            var chkPassportAppUser;
            var chkIsController;
            var chkControlDUser;
            var chkFTPUser;
            var l_ddlBasInstalID = document.getElementById("InstallID");

            if (l_ddlBasInstalID.options[l_ddlBasInstalID.selectedIndex].value != "") {
                l_BasInstalID = $("#InstallID option:selected").text();
            }

            if (document.getElementById('IsController').checked) {
                chkIsController = 'True';
            }
            else {
                chkIsController = 'False';
            }

            if (document.getElementById('IsControlDUser').checked) {
                chkControlDUser = 'True';
            }
            else {
                chkControlDUser = 'False';
            }

            if (document.getElementById('IsPassportAppUser').checked) {
                chkPassportAppUser = 'True';
            }
            else {
                chkPassportAppUser = 'False';
            }
            var TransversalData = {
                 UserID: '@ViewBag.UserID',
                FirstName: '@ViewBag.Firstname',
                Lastname: '@ViewBag.Lastname',
                TransversalID: $('#TransversalID').val(),
                TransversalSystemUserID: l_txtTUserID.value,
                TransversalParentUser: l_txtMainframeID.value,
                InstallID: $('#InstallID').val(),
                IsPassportAppUser: chkPassportAppUser,
                IsController: chkIsController,
                IsControlDUser: chkControlDUser
            };

            //CODESC: Call controller and pass the Transversal Account data.
            $.ajax({
                url: "/eDNA.WebPortal/TransversalManagement/AddTransversalToSession",
                data: TransversalData,
                type: "POST",
                success: function (p_ResponseTransversals) {
                    if (p_ResponseTransversals != null) {
                    }
                }
            });
            $('#tblMTransversals').append(

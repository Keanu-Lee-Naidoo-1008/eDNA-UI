@model eDNA.WebPortal.Models.CTransversalAccountData
@{
    List<eDNA.CommonData.Classes.CData_TransversalAccount> l_lstTransversalAccounts =
        ViewBag.TransversalAccounts as List<eDNA.CommonData.Classes.CData_TransversalAccount>
        ?? new List<eDNA.CommonData.Classes.CData_TransversalAccount>();

}

@if ((int)(ViewBag.ReturnToEnrolmentUserID ?? 0) > 0)
{
    <div class="alert alert-info">
        Reviewing transversal accounts for enrolment user <strong>@ViewBag.ReturnToEnrolmentUserID</strong>.
        Use <strong>Continue</strong> when no changes are pending, or <strong>Sign and Save</strong> to save account changes.

    </div>
}
<div class="panel-body">
    <div class="row">
        <div id="dvColorLegend" class="col-md-1" style="width:17%;">
            <label style="background-color:transparent;height:50px;color:transparent">Color Legend</label>
            <div class="list-group" id="dvColorLegend1" style="display:none">
                <center>
                    <label class="list-group-item" style="background-color:steelblue;color:white;font-size:18px;font-weight:200;">Color Legend</label>
                </center>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-normal" width="22" height="22" />
                    &nbsp;Normal
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-suspended" width="22" height="22" />
                    &nbsp;Suspended
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-pre-relinquished-owner" width="22" height="22" />
                    &nbsp;PreRelinquished - Owner
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-pre-relinquished-other-user" width="22" height="22" />
                    &nbsp;PreRelinquished - Other User
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-relinquished-owner" width="22" height="22" />
                    &nbsp;Relinquished - Owner
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-relinquished-other-user" width="22" height="22" />
                    &nbsp;Relinquished - Other User
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-relinquished-transfer-owner" width="22" height="22" />
                    &nbsp;RelinquishedTransfered - Owner
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-relinquished-transfer-other-user" width="24" height="22" />
                    &nbsp;RelinquishedTransfered - Other User
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-pre-returned-owner" width="22" height="22" />
                    &nbsp;PreReturn - Owner
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-returned" width="22" height="22" />
                    &nbsp;Returned
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-pre-transfer" width="22" height="22" />
                    &nbsp;PreTransfer
                </label>
                <label class="list-group-item-legend">
                    <img src="~/Content/Images/Enrolment/EmptyCircle.png" class="color-legend-default" width="22" height="22" />
                    &nbsp;Default
                </label>
            </div>
        </div>
        <form class="form-inline">
            <div class="col-md-1" style="width:15%">
                <h4 class="pull-left">Transversal Management</h4>
            </div>
            <div id="dvTManagementType" class="form-group">
                @Html.DropDownList("EnrolmentTypes", (ViewData["EnrolmentTypes"] as List<SelectListItem>) ?? new List<SelectListItem>(), new { @class = "form-control", style = "height:35px;width:100%", @Title = "Select Enrolment Type" })
            </div>
            <div class="form-group">
                @Html.DropDownList("SearchTypes", (ViewData["SearchTypes"] as List<SelectListItem>) ?? new List<SelectListItem>(), new { @class = "form-control", style = "height:35px;width:100%", @Title = "Select Search Type" })
            </div>
            @Html.TextBoxFor(model => model.TransversalSystemUserID, new { @class = "form-control", placeholder = "Enter search value", tabindex = 1, autocomplete = "off", style = "width:10%;height:35px", @Title = "Enter search value" })
            @Html.ValidationMessageFor(model => model.TransversalSystemUserID)
            <a href="javascript:SearchTransversal('/eDNA.WebPortal/TransversalManagement/GetTransversals')" class="btn btn-primary" data-toggle="tooltip" title="Search Transversal User" style="width:9%"><span class="glyphicon glyphicon-search"></span> Search</a>
            <a href="javascript:ClearAllSearchSessionValues('All')" class="btn btn-primary" data-toggle="tooltip" title="Clear" style="width:9%"><span class="glyphicon glyphicon-refresh"></span> Clear</a>
        </form>
        <div class="col-md-1" style="width:20.2%">
            <label style="color:transparent"></label>
        </div>
        <div class="form-group">
            <div id="dvTransversalList" class="col-md-8" style="display:none;width:65%;overflow-y:auto;height:500px">
                <div class="col-md-1" style="float: left; display: inline; width: auto; word-break: break-all; word-wrap: break-word;">

                    <h4> <span class="pull-right"> @ViewBag.Firstname @ViewBag.LastName Transaversal Account(s) :  </span> </h4>
                </div>
                <table class="table scroll" id="tblMTransversals">
                    <thead style="background-color:steelblue;color:white;">
                        <tr>
                            <th>Account ID<span class="pull-right glyphicon glyphicon-sort"></span></th>
                            <th>Transversal Type<span class="pull-right glyphicon glyphicon-sort"></span></th>
                            <th>Mainframe ID<span class="pull-right glyphicon glyphicon-sort"></span></th>
                            <th>InstallID<span class="pull-right glyphicon glyphicon-sort"></span></th>
                            <th>PassportApp<span class="pull-right glyphicon glyphicon-sort"></span></th>
                            <th>Controller<span class="pull-right glyphicon glyphicon-sort"></span></th>
                            <th>Control-D User<span class="pull-right glyphicon glyphicon-sort"></span></th>
                            @*<th>FTP User<span class="pull-right glyphicon glyphicon-sort"></span></th>*@
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var TransversalAccount in l_lstTransversalAccounts)
                        {
                            if (TransversalAccount == null)
                            {
                                continue;
                            }

                            if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.Normal)
                            {
                                <tr class="color-legend-normal">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                            else if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.Suspended)
                            {
                                <tr class="color-legend-suspended">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                            if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.PreRelinquish)
                            {
                                <tr class="color-legend-pre-relinquished-owner">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                            else if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.Relinquished)
                            {
                                <tr class="color-legend-relinquished-owner">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                            else if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.Relinquished_Transferred)
                            {
                                <tr class="color-legend-relinquished-transfer-owner">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                            else if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.PreReturned)
                            {
                                <tr class="color-legend-pre-returned-owner">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                            else if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.Returned)
                            {
                                <tr class="color-legend-returned">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                            else if (@TransversalAccount.TransversalAccountStatusID == eDNA.Common.enum_TransversalAccountStatus.PreTransferred)
                            {
                                <tr class="color-legend-pre-transfer">
                                    <td>@TransversalAccount.TransversalSystemUserID</td>
                                    <td>@TransversalAccount.TransversalID</td>
                                    <td>@TransversalAccount.TransversalParentUser</td>
                                    <td>@TransversalAccount.InstallDescription</td>
                                    <td>@TransversalAccount.IsPassportAppUser</td>
                                    <td>@TransversalAccount.IsController</td>
                                    <td>@TransversalAccount.IsControlDUser</td>
                                    @*<td>@TransversalAccount.IsFTPUser</td>*@
                                    <td><input type='checkbox' id="chkTSelect" name="chkTSelect" value='true' data-toggle="tooltip" title="Select"></td>
                                </tr>
                            }
                        }
                        @if (!l_lstTransversalAccounts.Any(a => a != null))
                        {
                            <tr class="ed-empty-row"><td colspan="8">@Html.Partial("_EmptyState", new ViewDataDictionary { { "EmptyHeading", "No transversal accounts" }, { "EmptyText", "This user has no transversal accounts yet. Use Add New Transversal to add one." } })</td></tr>
                        }
                    </tbody>
                    <tfoot style="background-color:steelblue;color:white">
                        <tr style="font-size:medium">
                            <td class="text-center" colspan="8">Transversal List</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div id="dvTransversalActions" class="col-md-2" style="width:15%;display:none">
                <div class="list-group">
                    <center>
                        <label class="list-group-item" style="background-color:steelblue;color:white;font-size:18px;font-weight:200;">Transversal Functions</label>
                    </center>
                    <a href="javascript:OpenTransversalMPopup()" class="list-group-item" data-placement="bottom" data-toggle="tooltip" title="Add new transversal to this eDNA User"><span class="glyphicon glyphicon-plus"></span> Add New Transversal </a>
                    @*<a href="javascript:ClearTransversals('TM')" class="list-group-item" data-placement="bottom" data-toggle="tooltip" title="Clear All New Transversals"><span class="glyphicon glyphicon-trash" style="color:red"></span> Clear All New Transversals </a>*@
                    <div>
                        <center>
                            <label class="list-group-item" style="background-color:steelblue;color:white;font-size:18px;font-weight:200;">Transversal Actions</label>
                        </center>
                        <a id="aSuspend" href="javascript:Suspend()" class="list-group-item-legend" style="color:blue" data-placement="bottom" data-toggle="tooltip" title="Suspend Selected Transversal Account"><span class="glyphicon glyphicon-thumbs-down"></span> Suspend</a>
                        <a id="aUnsuspend" href="javascript:UnSuspend()" class="list-group-item-legend" style="color:blue" data-placement="bottom" data-toggle="tooltip" title="Un-Suspend Selected Transversal Account"><span class="glyphicon glyphicon-thumbs-up"></span> Un-suspend</a>
                        <a id="aRelinquishN" href="javascript:OpeneDNAIDPopup('RN')" style="color:blue" class="list-group-item-legend" data-placement="bottom" data-toggle="tooltip" title="Relinquish (Normal) Selected Transversal Account"><span class="glyphicon  glyphicon-new-window"></span> Relinquish (Normal)</a>
                        <a id="aRelinquishF" href="javascript:OpeneDNAIDPopup('RF')" style="color:blue" class="list-group-item-legend" data-placement="bottom" data-toggle="tooltip" title="Relinquish (Force) Selected Transversal Account"><span class="glyphicon glyphicon-export"></span> Relinquish (Force)</a>
                        <a id="aReturnN" href="javascript:Return('RF')" class="list-group-item-legend" style="color:blue" data-placement="bottom" data-toggle="tooltip" title="Return (Normal) Selected Transversal Account"><span class="glyphicon glyphicon-retweet"></span> Return (Normal)</a>
                        <a id="aReturnF" href="javascript:Return('RN')" class="list-group-item-legend" style="color:blue" data-placement="bottom" data-toggle="tooltip" title="Return (Force) Selected Transversal Account"><span class="glyphicon glyphicon-random"></span> Return (Force)</a>
                        <a id="aTransfer" href="javascript:OpeneDNAIDPopup('T')" style="color:blue" class="list-group-item-legend" data-placement="bottom" data-toggle="tooltip" title="Transfer Selected Transversal Account"><span class="glyphicon glyphicon-transfer"></span> Transfer</a>
                        <a id="aPPassword" href="javascript:PPassword()" class="list-group-item-legend" style="color:blue" data-placement="bottom" data-toggle="tooltip" title="Provision Password For Selected Transversal Account"><span class="glyphicon glyphicon-star-empty"></span> Provision Password</a>
                        <a id="aRemove" href="javascript:TransversalDelete('Remove')" class="list-group-item-legend" style="color:blue" data-placement="bottom" data-toggle="tooltip" title="Delete Selected Transversal Account"><span class="glyphicon glyphicon-trash" style="color:red"></span> Remove</a>
                        <a href="#" class="list-group-item-legend" data-placement="bottom" data-toggle="tooltip"></a>
                    </div>
                </div>
            </div>

            <!-- Select Transversal Input Event Modal Pop up Window -->
            <div class="modal fade" id="mdTransversalsMModalPopUp" tabindex="-2" role="dialog" aria-labelledby="myModalLabel" data-placement="center" data-toggle="modal" data-backdrop="static" data-keyboard="false">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 id="Icon_Information">
                                <img src="~/Content/Images/Information.png" width="45" height="40" />&nbsp;<Label>Transversal Details</Label>
                            </h4>
                        </div>
                        @using (Html.BeginForm("", "", FormMethod.Post, new { id = "TransversalData" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="modal-body">
                                <Label>Please Select a Transversal.</Label>
                                <br />
                                <br />
                                @Html.Partial("_TransversalAccountFields", Model, new ViewDataDictionary(ViewData) { { "TransversalFieldMode", "Add" } })
                            </div>
                        }
                        <div class="modal-footer">
                            <img src="~/Content/Images/eDNA_logo.jpg" class="pull-left" height="45" />
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick="ResetTransversalControls()">Cancel</button>
                            <button type="button" id="btnAddMTransversal" class="btn btn-default" data-toggle="tooltip" title="Add Transversal to the list" data-placement="bottom">Add Transversal</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Input eDNA UserID for the Transversal Modal Pop up Window -->
            <div class="modal fade" id="mdeDNAIDPopup" tabindex="-2" role="dialog" aria-labelledby="myModalLabel" data-placement="center" data-toggle="modal" data-backdrop="static" data-keyboard="false">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 id="Icon_Information"><img src="~/Content/Images/Information.png" width="45" height="40" />&nbsp;<Label>Transversal Account Action</Label></h4>
                        </div>
                        <div class="modal-body">
                            <Label ID="lblTMMessage"></Label>
                            <br />
                            <center>
                                <Label>Action: </Label>&nbsp;
                                <Label id="lblTransversalAction"></Label>&nbsp;
                            </center>
                            <br />
                            <center>
                                <Label>eDNA ID</Label>&nbsp;
                                <input id="txteDNAID" type="text" placeholder="Enter eDNA UserID" maxlength="4" onkeydown="return ValidateNumber(event);">
                            </center>
                            <br />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                            <button type="button" id="btnTransversalOK" class="btn btn-default" data-dismiss="modal" data-toggle="tooltip" title="Enter eDNA ID to continue the process" data-placement="bottom">Ok</button>
                            <img src="~/Content/Images/eDNA_logo.jpg" class="pull-left" height="45" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="panel-footer pull-right" id="dvSave" style="display:none">
        <table>
            <tr style="box-shadow: 15px 15px 15px 5px whitesmoke;border: 1px">
                <td>
                    <a href="javascript:ClearTransversals('TM')" class="btn btn-primary" data-toggle="tooltip" title="Clear All New Transversals" style="width:140px"><span class="glyphicon glyphicon-circle-arrow-left"></span>Cancel</a>
                </td>
                <td width="70px"></td>
                <td>
                    <button id="btnTransversalPrimary" type="button" onclick="TransversalPrimaryAction()" class="btn btn-primary" disabled>Checking changes...</button>
                </td>
            </tr>
        </table>
    </div>
</div>


@*CODESC: Form Load Events*@
<script type="text/javascript">
    $(document).ready(function () {
        $("#MVCSiteMap").show();
        $("#tblMTransversals").tablesorter();
        //localStorage.setItem("m_isTransversalUpdate", 'False');

        //CODESC: Disable the search froup if Enrolment type value is 0.
        if ($("#EnrolmentTypes").val() > 0) {
            $("#dvSearchGroup :input").attr("disabled", false);
        }
        else {
            $("#dvSearchGroup :input").attr("disabled", true);
        }
        if ('@HttpContext.Current.Session["isTransversalFormLoad"]' == 'True') {
            $('#dvColorLegend1').hide();
            $('#dvTransversalList').hide();
            $('#dvTransversalActions').hide();
            $('#dvSave').hide();
          }
        if (localStorage.getItem("m_isTransversalUpdate")== 'True') {
            Notify("Transversal Management" + "<br>", "Transversal Created/Updated Successfully!!");

            localStorage.setItem("m_isTransversalUpdate", 'False');
        }
    });
    //CODESC: Transversal type selected index changed event
    $('Select#TransversalID').change(function () {
        var TransversalID = $('#TransversalID').val();
        document.getElementById("lnkRest").style.display = "";
        TransversalDDSelection(TransversalID, '');
    });
    if (localStorage.getItem("isSearchTransversal") == 'Search') {
        $('#dvColorLegend1').show();
        $('#dvTransversalList').show();
        $('#dvTransversalActions').show();
        $('#dvSave').show();
    }
    else {
        $('#dvColorLegend1').hide();
        $('#dvTransversalList').hide();
        $('#dvTransversalActions').hide();
        $('#dvSave').hide();
    }
</script>


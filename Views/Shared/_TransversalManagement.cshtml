@*CODESC: Remove selected transversal from the Transversal list*@
<script type="text/javascript">
    function RemoveTransversal(row) {

        //CODESC: Get the clicked row index
        var l_intRowIndex = row.parentNode.parentNode.rowIndex;

        //CODESC: Get the table control
        var l_tblTransversal = document.getElementById('tblMTransversals');

        //CODESC: Get the clicked row of column values
        var l_strRowValue = l_tblTransversal.rows[l_intRowIndex].innerHTML;

        //CODESC: Split the values into a list by '</td>'
        var l_lstTValues = l_strRowValue.split('</td>');

        //CODESC: Separate the TransversalUserID and TransversalTypeID
        var l_strTransversalUserID = l_lstTValues[0].substring(4, l_lstTValues[0].length);
        var l_strTransversalType = l_lstTValues[1].substring(4, l_lstTValues[1].length);

        //CODESC: Remove deleted row of table from the session variable TransversalAccountList_After
        $.ajax({
            type: "POST",
            dataType: "json",
            traditional: true,
            url: "/eDNA.WebPortal/TransversalManagement/RemoveTransversalFromSession",
            data: JSON.stringify({ 'p_strTransversalUserID': l_strTransversalUserID, 'p_strTransversalTypeID': l_strTransversalType }),
            contentType: "application/json; charset=utf-8",
            success: function (p_ResponseTransversals) {
                if (p_ResponseTransversals != null) {
                }
            }
        });

        //CODESC: Remove the deleted row from the table
        document.getElementById('tblMTransversals').deleteRow(l_intRowIndex);
    }
</script>


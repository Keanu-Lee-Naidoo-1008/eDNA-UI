@* Modern theme for the eDNA Web Portal.
   Rendered in _MasterLayout <head> after the original CSS bundle, so it overrides Bootstrap 3 and Site.css
   without changing either. Colour values live only in the two colour blocks below (light in :root, dark after it);
   every other rule uses them. Dark mode follows the OS setting; <html data-theme="light|dark"> overrides it
   (set by the toggle script at the end of this file).
   Razor note: CSS at-rules must be written as @@media / @@keyframes in this file. *@
<style>
    :root {
        color-scheme: light;

        /* ---- Colour: light mode (blue / white) ---- */
        --ed-primary: #1e5bd8;         /* accent: primary buttons, links, active step, live finger, face ring */
        --ed-primary-hover: #174ab3;
        --ed-primary-soft: rgba(30, 91, 216, .08);   /* accent tint: selected or live tile */
        --ed-on-accent: #ffffff;       /* text on accent and success fills */
        --ed-success: #14996f;         /* ticks, captured, pass states */
        --ed-success-soft: rgba(20, 153, 111, .1);
        --ed-warning: #b97a0a;         /* low quality scores, queued or pending */
        --ed-warning-soft: rgba(185, 122, 10, .1);
        --ed-danger: #d23b3b;          /* errors, failed capture, clear/delete */
        --ed-danger-soft: rgba(210, 59, 59, .08);

        --ed-bg: #f4f7fb;              /* page background */
        --ed-surface: #ffffff;         /* panels, cards, modals, top bar */
        --ed-surface-2: #eef3fa;       /* raised: finger tiles, inputs, hover states */
        --ed-border: #dae3ef;          /* card and input borders, dividers, empty stepper bars */
        --ed-border-strong: var(--ed-border);
        --ed-text: #0c1b33;
        --ed-text-muted: #5a6a84;      /* labels, meta info, placeholders */
        --ed-focus: var(--ed-primary);
        --ed-focus-ring: rgba(30, 91, 216, .25);
        --ed-overlay: rgba(244, 247, 251, .9);
        --ed-logo-bg: transparent;     /* backdrop for the eDNA logo, which is drawn for light backgrounds */
        --ed-shadow-rgb: 12, 27, 51;

        /* ---- Type ---- */
        --ed-font: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
        --ed-font-mono: Consolas, "Cascadia Mono", Menlo, monospace;
        --ed-fs-sm: 13px;
        --ed-fs-base: 15px;
        --ed-fs-lg: 18px;
        --ed-fs-xl: 22px;
        --ed-fs-2xl: 28px;

        /* ---- Shape & space ---- */
        --ed-radius-sm: 6px;
        --ed-radius: 10px;
        --ed-radius-lg: 14px;
        --ed-shadow-sm: 0 1px 2px rgba(var(--ed-shadow-rgb), .06);
        --ed-shadow: 0 2px 8px rgba(var(--ed-shadow-rgb), .08);
        --ed-shadow-lg: 0 12px 32px rgba(var(--ed-shadow-rgb), .16);
        --ed-space-1: 4px;
        --ed-space-2: 8px;
        --ed-space-3: 12px;
        --ed-space-4: 16px;
        --ed-space-5: 24px;
        --ed-space-6: 32px;

        /* ---- Shell sizes ---- */
        --ed-topbar-h: 64px;
        --ed-statusbar-h: 40px;
        --ed-content-max: 1320px;
    }

    /* ---- Colour: dark mode (navy / turquoise). Keep both blocks identical. ---- */
    @@media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
            color-scheme: dark;
            --ed-primary: #5ee6d0;
            --ed-primary-hover: #7befdc;
            --ed-primary-soft: rgba(94, 230, 208, .12);
            --ed-on-accent: #04201c;
            --ed-success: #5ee6d0;
            --ed-success-soft: rgba(94, 230, 208, .12);
            --ed-warning: #f2b544;
            --ed-warning-soft: rgba(242, 181, 68, .12);
            --ed-danger: #f06c6c;
            --ed-danger-soft: rgba(240, 108, 108, .12);
            --ed-bg: #0a0f1c;
            --ed-surface: #111a2b;
            --ed-surface-2: #16213a;
            --ed-border: #22304a;
            --ed-text: #e7eef8;
            --ed-text-muted: #8c9ab2;
            --ed-focus-ring: rgba(94, 230, 208, .3);
            --ed-overlay: rgba(10, 15, 28, .88);
            --ed-logo-bg: #ffffff;
            --ed-shadow-rgb: 0, 0, 0;
        }
    }
    :root[data-theme="dark"] {
        color-scheme: dark;
        --ed-primary: #5ee6d0;
        --ed-primary-hover: #7befdc;
        --ed-primary-soft: rgba(94, 230, 208, .12);
        --ed-on-accent: #04201c;
        --ed-success: #5ee6d0;
        --ed-success-soft: rgba(94, 230, 208, .12);
        --ed-warning: #f2b544;
        --ed-warning-soft: rgba(242, 181, 68, .12);
        --ed-danger: #f06c6c;
        --ed-danger-soft: rgba(240, 108, 108, .12);
        --ed-bg: #0a0f1c;
        --ed-surface: #111a2b;
        --ed-surface-2: #16213a;
        --ed-border: #22304a;
        --ed-text: #e7eef8;
        --ed-text-muted: #8c9ab2;
        --ed-focus-ring: rgba(94, 230, 208, .3);
        --ed-overlay: rgba(10, 15, 28, .88);
        --ed-logo-bg: #ffffff;
        --ed-shadow-rgb: 0, 0, 0;
    }

    /* ================= Base ================= */
    html, body {
        background: var(--ed-bg) !important;
        background-image: none !important;
    }
    body {
        font-family: var(--ed-font);
        font-size: var(--ed-fs-base);
        line-height: 1.5;
        color: var(--ed-text);
        padding-top: var(--ed-topbar-h);
        padding-bottom: var(--ed-statusbar-h);
        min-height: 100vh;
    }
    h1, h2, h3, h4, h5 { font-family: var(--ed-font); color: var(--ed-text); font-weight: 600; }
    a { color: var(--ed-primary); }
    a:hover, a:focus { color: var(--ed-primary-hover); }
    label { font-weight: 600; }
    :focus-visible { outline: 3px solid var(--ed-focus); outline-offset: 2px; }
    .text-muted { color: var(--ed-text-muted); }
    .text-danger { color: var(--ed-danger); }
    .ed-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ================= Shell: top bar ================= */
    header.ed-header { position: relative; z-index: 1030; }
    .navbar-fixed-top.ed-topbar {
        display: flex;
        align-items: center;
        gap: var(--ed-space-4);
        height: var(--ed-topbar-h);
        min-height: 0;
        margin: 0;
        padding: 0 var(--ed-space-5);
        background: var(--ed-surface);
        border: 0;
        border-bottom: 1px solid var(--ed-border);
        border-radius: 0;
        box-shadow: var(--ed-shadow-sm);
        color: var(--ed-text);
    }
    .ed-topbar .ed-brand { display: flex; align-items: center; gap: var(--ed-space-3); min-width: 0; }
    .ed-topbar .ed-brand img { height: 36px; width: auto; background: var(--ed-logo-bg); border-radius: var(--ed-radius-sm); padding: 3px 6px; }
    .ed-topbar .ed-page-title {
        font-size: var(--ed-fs-lg);
        font-weight: 600;
        color: var(--ed-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .ed-topbar .ed-topbar-actions { margin-left: auto; display: flex; align-items: center; gap: var(--ed-space-2); }
    .ed-topbar .ed-topbar-actions > div { float: none; }
    .ed-topbar .ed-topbar-link,
    .ed-topbar .dropdown-toggle.ed-topbar-link {
        display: inline-flex;
        align-items: center;
        gap: var(--ed-space-2);
        padding: 8px 12px;
        border-radius: var(--ed-radius-sm);
        color: var(--ed-text);
        font-size: var(--ed-fs-base);
        font-weight: 500;
        text-decoration: none;
        background: transparent;
        border: 0;
        white-space: nowrap;
    }
    .ed-topbar .ed-topbar-link:hover,
    .ed-topbar .ed-topbar-link:focus,
    .ed-topbar .open > .ed-topbar-link { background: var(--ed-surface-2); color: var(--ed-primary); }
    .ed-topbar .ed-theme-toggle { cursor: pointer; }
    .ed-topbar .ed-theme-toggle .ed-theme-icon-light { display: none; }
    :root[data-ed-dark] .ed-topbar .ed-theme-toggle .ed-theme-icon-light { display: inline-block; }
    :root[data-ed-dark] .ed-topbar .ed-theme-toggle .ed-theme-icon-dark { display: none; }
    .ed-topbar .dropdown-menu {
        right: 0;
        left: auto;
        min-width: 240px;
        margin-top: 6px;
        padding: var(--ed-space-1);
        background: var(--ed-surface);
        border: 1px solid var(--ed-border);
        border-radius: var(--ed-radius);
        box-shadow: var(--ed-shadow-lg);
    }
    .ed-topbar .dropdown-menu > li > a.list-group-item {
        display: flex;
        align-items: center;
        gap: var(--ed-space-2);
        width: auto;
        margin: 0;
        padding: 10px 12px;
        border: 0;
        border-radius: var(--ed-radius-sm);
        color: var(--ed-text);
        font-size: var(--ed-fs-base);
        background: transparent;
    }
    .ed-topbar .dropdown-menu > li > a.list-group-item:hover,
    .ed-topbar .dropdown-menu > li > a.list-group-item:focus { background: var(--ed-primary-soft); color: var(--ed-primary-hover); }
    .ed-topbar .dropdown-menu > li:empty { display: none; }

    /* ================= Shell: banners, breadcrumb, wizard ================= */
    .ed-env-banner {
        padding: 10px var(--ed-space-5);
        background: var(--ed-warning-soft);
        color: var(--ed-text);
        border-bottom: 2px solid var(--ed-warning);
        text-align: center;
        font-weight: 500;
    }
    #MVCSiteMap .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--ed-space-1);
        margin: 0;
        padding: 10px var(--ed-space-5);
        background: var(--ed-surface);
        border-bottom: 1px solid var(--ed-border);
        border-radius: 0;
        font-size: var(--ed-fs-sm);
        color: var(--ed-text-muted);
    }
    #MVCSiteMap .breadcrumb a { color: var(--ed-primary); }
    #MVCSiteMap #dvClose { margin-left: auto; }
    #MVCSiteMap #dvClose a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: var(--ed-radius-sm);
        color: var(--ed-text-muted);
        font-weight: 600;
        text-decoration: none;
    }
    #MVCSiteMap #dvClose a:hover { background: var(--ed-surface-2); color: var(--ed-text); }

    #UserEnromentWizard.breadcrumb {
        margin: 0;
        padding: var(--ed-space-4) var(--ed-space-5);
        background: var(--ed-surface);
        border-bottom: 1px solid var(--ed-border);
        border-radius: 0;
    }
    .ed-wizard-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--ed-space-4);
        max-width: var(--ed-content-max);
        margin: 0 auto;
    }
    .ed-wizard-heading { display: flex; flex-direction: column; min-width: 0; }
    .ed-wizard-eyebrow {
        font-size: var(--ed-fs-sm);
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--ed-text-muted);
    }
    #lblUserEnrolment { margin: 0; font-size: var(--ed-fs-lg); font-weight: 600; color: var(--ed-text); }
    .ed-steps { display: flex; align-items: center; gap: var(--ed-space-2); margin: 0; padding: 0; list-style: none; flex-wrap: wrap; }
    .ed-step { display: flex; align-items: center; gap: var(--ed-space-2); color: var(--ed-text-muted); font-size: var(--ed-fs-sm); font-weight: 600; }
    .ed-step + .ed-step::before { content: ""; width: 28px; height: 2px; background: var(--ed-border-strong); margin-right: var(--ed-space-1); }
    .ed-step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid var(--ed-border-strong);
        background: var(--ed-surface);
        font-size: var(--ed-fs-sm);
    }
    .ed-step.is-current { color: var(--ed-primary); }
    .ed-step.is-current .ed-step-num { border-color: var(--ed-primary); background: var(--ed-primary); color: var(--ed-on-accent); }
    .ed-step.is-done { color: var(--ed-success); }
    .ed-step.is-done .ed-step-num { border-color: var(--ed-success); background: var(--ed-success-soft); color: var(--ed-success); }
    .ed-step.is-done + .ed-step::before { background: var(--ed-success); }

    /* ================= Shell: main + status bar ================= */
    .ed-main { padding: var(--ed-space-5); }
    .ed-main > * { max-width: var(--ed-content-max); margin-left: auto; margin-right: auto; }

    footer.ed-statusbar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1020;
        height: var(--ed-statusbar-h);
        background: var(--ed-surface);
        border-top: 1px solid var(--ed-border);
        font-size: var(--ed-fs-sm);
        color: var(--ed-text-muted);
    }
    .ed-statusbar-inner { display: flex; align-items: center; gap: var(--ed-space-5); height: 100%; padding: 0 var(--ed-space-5); }
    .ed-statusbar .messagePanel { display: flex; align-items: center; gap: var(--ed-space-2); }
    .ed-statusbar .messagePanel img { width: 12px; height: 12px; }
    .ed-statusbar #ApplicationInfo { color: var(--ed-text); font-weight: 600; }
    .ed-statusbar-message { display: flex; align-items: center; gap: var(--ed-space-2); flex: 1; min-width: 0; }
    .ed-statusbar-message img { width: 18px; height: 18px; }
    .ed-statusbar #applicationMessage { font-size: var(--ed-fs-sm); color: var(--ed-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ed-statusbar-meta { display: flex; align-items: center; gap: var(--ed-space-4); margin-left: auto; white-space: nowrap; }
    .ed-statusbar #clock { font-family: var(--ed-font-mono); color: var(--ed-text); }

    /* ================= Busy overlay ================= */
    #divLoading.ed-busy { position: fixed; inset: 0; z-index: 30001; background: var(--ed-overlay); }
    .ed-busy-card {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 480px;
        max-width: 90%;
        padding: 36px;
        text-align: center;
        background: var(--ed-surface);
        border-radius: var(--ed-radius-lg);
        box-shadow: var(--ed-shadow-lg);
        color: var(--ed-text);
    }
    .ed-busy-card h3 { margin-top: 0; }
    .edna-busy-spinner {
        width: 48px;
        height: 48px;
        margin: 0 auto 24px;
        border: 5px solid var(--ed-primary-soft);
        border-top-color: var(--ed-primary);
        border-radius: 50%;
        animation: edna-busy-spin 1s linear infinite;
    }
    @@keyframes edna-busy-spin { to { transform: rotate(360deg); } }
    @@media (prefers-reduced-motion: reduce) { .edna-busy-spinner { animation: none; } }

    /* ================= Bootstrap 3 overrides ================= */
    .btn {
        border-radius: var(--ed-radius-sm);
        font-weight: 600;
        padding: 9px 18px;
        font-size: var(--ed-fs-base);
        transition: background-color .15s, border-color .15s, box-shadow .15s;
    }
    .btn .glyphicon { margin-right: 4px; top: 2px; }
    .btn-lg { padding: 12px 24px; font-size: var(--ed-fs-lg); }
    .btn-primary { background: var(--ed-primary); border-color: var(--ed-primary); color: var(--ed-on-accent); }
    .btn-primary:hover, .btn-primary:focus, .btn-primary:active, .btn-primary.active { background: var(--ed-primary-hover); border-color: var(--ed-primary-hover); color: var(--ed-on-accent); }
    .btn-default { background: var(--ed-surface); border-color: var(--ed-border-strong); color: var(--ed-text); }
    .btn-default:hover, .btn-default:focus { background: var(--ed-surface-2); border-color: var(--ed-border-strong); color: var(--ed-text); }
    /* Secondary look for buttons that must keep the btn-primary class. */
    .btn.ed-btn-secondary { background: var(--ed-surface); border-color: var(--ed-border-strong); color: var(--ed-text); }
    .btn.ed-btn-secondary:hover, .btn.ed-btn-secondary:focus { background: var(--ed-surface-2); color: var(--ed-text); }
    .btn.ed-btn-success { background: var(--ed-success); border-color: var(--ed-success); color: var(--ed-on-accent); }
    .btn.ed-btn-success:hover, .btn.ed-btn-success:focus { filter: brightness(.92); color: var(--ed-on-accent); }
    .btn[disabled], .btn.disabled { opacity: .5; }

    .form-control {
        height: 40px;
        padding: 8px 12px;
        border: 1px solid var(--ed-border-strong);
        border-radius: var(--ed-radius-sm);
        box-shadow: none;
        font-size: var(--ed-fs-base);
        color: var(--ed-text);
    }
    textarea.form-control { height: auto; }
    .form-control:focus { border-color: var(--ed-focus); box-shadow: 0 0 0 3px var(--ed-focus-ring); }
    .form-control[readonly] { background: var(--ed-surface-2); color: var(--ed-text-muted); }
    select.dropdown, select.dropdown-btn { height: 40px; padding: 6px 10px; border: 1px solid var(--ed-border-strong); border-radius: var(--ed-radius-sm); background: var(--ed-surface); color: var(--ed-text); }

    .table > thead > tr > th {
        background: var(--ed-surface-2);
        color: var(--ed-text-muted);
        font-size: var(--ed-fs-sm);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        border-bottom: 1px solid var(--ed-border);
    }
    .table > tbody > tr > td { border-top: 1px solid var(--ed-border); vertical-align: middle; }
    .table-hover > tbody > tr:hover { background: var(--ed-primary-soft); }

    .table { background: transparent; color: var(--ed-text); }
    .table-striped > tbody > tr:nth-of-type(odd) { background: var(--ed-surface-2); }
    .table-bordered, .table-bordered > thead > tr > th, .table-bordered > tbody > tr > td { border-color: var(--ed-border); }
    .form-control, select.dropdown, select.dropdown-btn { background-color: var(--ed-surface-2); }
    .form-control::placeholder { color: var(--ed-text-muted); opacity: 1; }
    .input-group-addon { background: var(--ed-surface-2); border-color: var(--ed-border); color: var(--ed-text-muted); }
    .help-block { color: var(--ed-text-muted); }
    .has-error .form-control { border-color: var(--ed-danger); }
    .has-error .help-block, .has-error .control-label { color: var(--ed-danger); }
    hr { border-top-color: var(--ed-border); }
    fieldset, legend { border-color: var(--ed-border); color: var(--ed-text); }

    .panel { background: var(--ed-surface); border: 1px solid var(--ed-border); border-radius: var(--ed-radius); box-shadow: var(--ed-shadow-sm); color: var(--ed-text); }
    .panel-default > .panel-heading { background: var(--ed-surface-2); border-color: var(--ed-border); color: var(--ed-text); }
    .panel-footer { background: var(--ed-surface-2); border-top-color: var(--ed-border); }
    .well, .thumbnail { background: var(--ed-surface-2); border-color: var(--ed-border); color: var(--ed-text); }
    .list-group-item { background: var(--ed-surface); border-color: var(--ed-border); color: var(--ed-text); }
    a.list-group-item:hover, a.list-group-item:focus, button.list-group-item:hover { background: var(--ed-surface-2); color: var(--ed-text); }
    .list-group-item.active, .list-group-item.active:hover, .list-group-item.active:focus { background: var(--ed-primary-soft); border-color: var(--ed-primary); color: var(--ed-primary); }
    .dropdown-menu { background: var(--ed-surface); border-color: var(--ed-border); }
    .dropdown-menu > li > a { color: var(--ed-text); }
    .dropdown-menu > li > a:hover, .dropdown-menu > li > a:focus { background: var(--ed-primary-soft); color: var(--ed-primary); }
    .dropdown-menu .divider { background: var(--ed-border); }
    .nav-tabs { border-bottom-color: var(--ed-border); }
    .nav-tabs > li > a { color: var(--ed-text-muted); }
    .nav-tabs > li > a:hover { background: var(--ed-surface-2); border-color: transparent; }
    .nav-tabs > li.active > a, .nav-tabs > li.active > a:hover, .nav-tabs > li.active > a:focus { background: var(--ed-surface); border-color: var(--ed-border) var(--ed-border) transparent; color: var(--ed-primary); }
    .nav-pills > li.active > a, .nav-pills > li.active > a:hover { background: var(--ed-primary); color: var(--ed-on-accent); }
    .pagination > li > a, .pagination > li > span { background: var(--ed-surface); border-color: var(--ed-border); color: var(--ed-primary); }
    .pagination > .active > a, .pagination > .active > span { background: var(--ed-primary); border-color: var(--ed-primary); color: var(--ed-on-accent); }
    .popover { background: var(--ed-surface); border-color: var(--ed-border); color: var(--ed-text); }
    .close { color: var(--ed-text); text-shadow: none; }
    .badge { background: var(--ed-surface-2); color: var(--ed-text); }
    .text-success { color: var(--ed-success); }
    .text-warning { color: var(--ed-warning); }
    .text-primary, .btn-link { color: var(--ed-primary); }

    .btn-danger { background: var(--ed-danger); border-color: var(--ed-danger); color: var(--ed-on-accent); }
    .btn-danger:hover, .btn-danger:focus { filter: brightness(.92); background: var(--ed-danger); border-color: var(--ed-danger); color: var(--ed-on-accent); }
    .btn-success { background: var(--ed-success); border-color: var(--ed-success); color: var(--ed-on-accent); }
    .btn-success:hover, .btn-success:focus { filter: brightness(.92); background: var(--ed-success); border-color: var(--ed-success); color: var(--ed-on-accent); }
    .btn-info { background: var(--ed-surface); border-color: var(--ed-primary); color: var(--ed-primary); }
    .btn-info:hover, .btn-info:focus { background: var(--ed-primary-soft); border-color: var(--ed-primary); color: var(--ed-primary-hover); }
    .btn-warning { background: var(--ed-warning); border-color: var(--ed-warning); color: var(--ed-on-accent); }

    /* Alerts: tinted fill, coloured edge, body text in the normal text colour so both modes stay readable. */
    .alert { border-radius: var(--ed-radius); border: 1px solid var(--ed-border); border-left-width: 4px; color: var(--ed-text); }
    .alert-info { background: var(--ed-primary-soft); border-left-color: var(--ed-primary); }

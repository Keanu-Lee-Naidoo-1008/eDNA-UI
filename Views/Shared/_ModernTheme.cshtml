            try { return localStorage.getItem('ed-theme'); } catch (e) { return null; }
        }
        function applyTheme() {
            var l_Saved = savedTheme();
            if (l_Saved === 'light' || l_Saved === 'dark') l_Root.setAttribute('data-theme', l_Saved);
            else l_Root.removeAttribute('data-theme');
            var l_IsDark = l_Saved ? l_Saved === 'dark' : !!(l_DarkQuery && l_DarkQuery.matches);
            if (l_IsDark) l_Root.setAttribute('data-ed-dark', '');
            else l_Root.removeAttribute('data-ed-dark');
        }
        window.EdToggleTheme = function () {
            var l_Next = l_Root.hasAttribute('data-ed-dark') ? 'light' : 'dark';
            try { localStorage.setItem('ed-theme', l_Next); } catch (e) { }
            applyTheme();
            if (!savedTheme()) {   // storage blocked: still switch for this page
                l_Root.setAttribute('data-theme', l_Next);
                if (l_Next === 'dark') l_Root.setAttribute('data-ed-dark', ''); else l_Root.removeAttribute('data-ed-dark');
            }
        };
        if (l_DarkQuery && l_DarkQuery.addEventListener) l_DarkQuery.addEventListener('change', applyTheme);
        applyTheme();
    })();

    // Presentation only: mark capture thumbnails whose image failed to load so the CSS
    // placeholder shows instead of the browser's broken-image icon. No IDs or values change.
    (function () {
        function inSlot(p_Element) {
            return p_Element && p_Element.tagName === 'IMG' && p_Element.closest && p_Element.closest('.ed-capture-slot');
        }
        document.addEventListener('error', function (p_Event) {
            if (inSlot(p_Event.target)) p_Event.target.classList.add('ed-img-empty');
        }, true);
        document.addEventListener('load', function (p_Event) {
            if (inSlot(p_Event.target)) p_Event.target.classList.remove('ed-img-empty');
        }, true);
    })();
</script>

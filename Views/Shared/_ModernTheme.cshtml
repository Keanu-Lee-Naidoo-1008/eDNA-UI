    .ed-logon-title { margin: 0 0 var(--ed-space-1); font-size: var(--ed-text-xl); }
    .ed-logon-welcome { display: block; color: var(--ed-text-muted); }
    .ed-logon-table { width: 100%; margin-top: var(--ed-space-5); }
    .ed-logon-table td { padding: 0; }
    .ed-logon .biometric-logon-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--ed-space-2);
        margin-top: var(--ed-space-3);
        padding: 14px 20px;
        border-radius: var(--ed-radius);
        background: var(--ed-accent);
        color: var(--ed-on-accent);
        font-size: var(--ed-text-lg);
        font-weight: 600;
        text-decoration: none;
    }
    .ed-logon .biometric-logon-link:hover, .ed-logon .biometric-logon-link:focus { background: var(--ed-accent-hover); color: var(--ed-on-accent); }
    .ed-logon .biometric-logon-message { padding: var(--ed-space-3); border-radius: var(--ed-radius); background: var(--ed-warning-soft); border-left: 4px solid var(--ed-warning); color: var(--ed-text); text-align: left; }
    .ed-logon-hint { margin: var(--ed-space-5) 0 0; font-size: var(--ed-text-sm); color: var(--ed-text-muted); }

    /* ================= Alignment =================
       Body text, labels, tables, panels and wizard content read from the left. Only the logon screen,
       empty states and modal confirmations are centred. Done here so no markup classes change. */
    .ed-main center { display: block; text-align: left; }
    .ed-main [style*="text-align:center"], .ed-main [style*="text-align: center"] { text-align: left !important; }
    .ed-main .table .text-center { text-align: left; }
    .ed-main .modal center, .ed-main .modal [style*="text-align:center"], .ed-main .modal [style*="text-align: center"] { text-align: center !important; }

    /* ================= Legacy inline styles =================
       Older views carry inline colours, sizes, borders and shadows. These map them onto the tokens so they
       follow both modes and the rules above, without editing the views. Capture <img> borders
       (border:groove + border-color) are left alone: the capture scripts recolour them to show status. */
    [style*="background-color:steelblue"], [style*="background-color: steelblue"], [style*="background-color:sandybrown"] {
        background-color: var(--ed-surface-2) !important;
        border-color: var(--ed-border) !important;
        color: var(--ed-text-muted) !important;
    }
    [style*="steelblue"] [style*="color:white"], [style*="steelblue"][style*="color:white"], [style*="steelblue"] font[color="white"] {
        color: var(--ed-text-muted) !important;
        font-size: var(--ed-text-sm) !important;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    font[color="white"] { color: inherit; }
    font[size="5"] { font-family: var(--ed-font-display); font-size: var(--ed-text-xl); color: var(--ed-heading); }
    [style*="ghostwhite"], [style*="whitesmoke"] { background-color: var(--ed-surface-2) !important; }
    [style*="color:black"] { color: var(--ed-text) !important; }
    [style*="color:blue"] { color: var(--ed-accent) !important; }
    [style*="color:#1f4e79"] { color: var(--ed-heading) !important; }
    a[style*="color:red"], label[style*="color:red"], span[style*="color:red"] { color: var(--ed-danger) !important; }
    /* Row selection set by script (.css("backgroundColor", ...)): selected = accent tint. */
    a[style*="background-color: white"], a[style*="background-color: lightskyblue"] { background-color: var(--ed-accent-soft) !important; }
    [style*="box-shadow"] { box-shadow: none !important; }
    [style*="border-radius"]:not(.wheel_icon) { border-radius: var(--ed-radius) !important; }
    [style*="border:ridge"]:not(.wheel_icon), [style*="border: 1px solid #000000"] { border: 1px solid var(--ed-border) !important; border-radius: var(--ed-radius); }
    [style*="font-size:medium"], [style*="font-size:12pt"], [style*="font-size:16px"] { font-size: var(--ed-text-base) !important; }
    [style*="font-size:12px"] { font-size: var(--ed-text-sm) !important; }
    [style*="font-size:large"], [style*="font-size:18px"], [style*="font-size:1.25em"] { font-size: var(--ed-text-lg) !important; }
    [style*="font-size:x-large"] { font-size: var(--ed-text-xl) !important; }
    /* PKI dialog backdrops are inline rgba: use the theme overlay. */
    #PkiInstallationDialog, #PkiConfirmDialog { background: var(--ed-overlay) !important; }
    /* Forensic review page carries its own <style> block (later in the page, so these need extra weight). */
    body #forensicReview .approval-panel { background: var(--ed-surface-2); border: 1px solid var(--ed-border); border-radius: var(--ed-radius); }
    body #forensicReview .review-confirmation { background: var(--ed-surface); border-color: var(--ed-border-strong); border-radius: var(--ed-radius); font-size: var(--ed-text-base); }
    body #forensicReview #reviewConfirmed:focus { outline: var(--ed-focus-outline); }

    /* ================= Responsive ================= */
    @@media (max-width: 1100px) {

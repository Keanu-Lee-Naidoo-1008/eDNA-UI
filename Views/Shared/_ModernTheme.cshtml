@* Modern theme for the eDNA Web Portal.
   Rendered in _MasterLayout <head> after the original CSS bundle, so it overrides Bootstrap 3 and Site.css
   without changing either. Brand values live only in the :root block below; every other rule uses them.
   Razor note: CSS at-rules must be written as @@media / @@keyframes in this file. *@
<style>
    :root {
        /* ---- Brand tokens (PLACEHOLDERS: replace with the company design) ---- */
        --ed-navy: #1b2a47;            /* header / dark surfaces (from the desktop capture app) */
        --ed-navy-2: #26395e;
        --ed-primary: #1f6fb2;         /* primary actions, links, active step */
        --ed-primary-hover: #185a91;
        --ed-primary-soft: #e8f1fa;
        --ed-success: #16884a;         /* verified / complete (capture app "Process Face") */
        --ed-success-soft: #e7f5ec;
        --ed-warning: #a86400;
        --ed-warning-soft: #fff4e0;
        --ed-danger: #c0392b;
        --ed-danger-soft: #fdecea;

        /* ---- Neutrals ---- */
        --ed-bg: #f3f5f8;
        --ed-surface: #ffffff;
        --ed-surface-2: #f7f9fb;
        --ed-border: #dde3ea;
        --ed-border-strong: #c3ccd6;
        --ed-text: #1e2a38;
        --ed-text-muted: #5b6b7c;
        --ed-on-dark: #ffffff;
        --ed-focus: #2b8fe0;

        /* ---- Type ---- */
        --ed-font: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
        --ed-font-mono: Consolas, "Cascadia Mono", Menlo, monospace;
        --ed-fs-sm: 13px;
        --ed-fs-base: 15px;
        --ed-fs-lg: 18px;
        --ed-fs-xl: 22px;
        --ed-fs-2xl: 28px;

        /* ---- Shape & space ---- */
        --ed-radius-sm: 6px;
        --ed-radius: 10px;
        --ed-radius-lg: 14px;
        --ed-shadow-sm: 0 1px 2px rgba(16, 32, 56, .06);
        --ed-shadow: 0 2px 8px rgba(16, 32, 56, .08);
        --ed-shadow-lg: 0 12px 32px rgba(16, 32, 56, .16);
        --ed-space-1: 4px;
        --ed-space-2: 8px;
        --ed-space-3: 12px;
        --ed-space-4: 16px;
        --ed-space-5: 24px;
        --ed-space-6: 32px;

        /* ---- Shell sizes ---- */
        --ed-topbar-h: 64px;
        --ed-statusbar-h: 40px;
        --ed-content-max: 1320px;
    }

    /* ================= Base ================= */
    html, body {
        background: var(--ed-bg) !important;
        background-image: none !important;
    }
    body {
        font-family: var(--ed-font);
        font-size: var(--ed-fs-base);
        line-height: 1.5;
        color: var(--ed-text);
        padding-top: var(--ed-topbar-h);
        padding-bottom: var(--ed-statusbar-h);
        min-height: 100vh;
    }
    h1, h2, h3, h4, h5 { font-family: var(--ed-font); color: var(--ed-text); font-weight: 600; }
    a { color: var(--ed-primary); }
    a:hover, a:focus { color: var(--ed-primary-hover); }
    label { font-weight: 600; }
    :focus-visible { outline: 3px solid var(--ed-focus); outline-offset: 2px; }
    .text-muted { color: var(--ed-text-muted); }
    .text-danger { color: var(--ed-danger); }
    .ed-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ================= Shell: top bar ================= */
    header.ed-header { position: relative; z-index: 1030; }
    .navbar-fixed-top.ed-topbar {
        display: flex;
        align-items: center;
        gap: var(--ed-space-4);
        height: var(--ed-topbar-h);
        min-height: 0;
        margin: 0;
        padding: 0 var(--ed-space-5);
        background: var(--ed-navy);
        border: 0;
        border-radius: 0;
        box-shadow: var(--ed-shadow);
        color: var(--ed-on-dark);
    }
    .ed-topbar .ed-brand { display: flex; align-items: center; gap: var(--ed-space-3); min-width: 0; }
    .ed-topbar .ed-brand img { height: 36px; width: auto; background: var(--ed-surface); border-radius: var(--ed-radius-sm); padding: 3px 6px; }
    .ed-topbar .ed-page-title {
        font-size: var(--ed-fs-lg);
        font-weight: 600;
        color: var(--ed-on-dark);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .ed-topbar .ed-topbar-actions { margin-left: auto; display: flex; align-items: center; gap: var(--ed-space-2); }
    .ed-topbar .ed-topbar-actions > div { float: none; }
    .ed-topbar .ed-topbar-link,
    .ed-topbar .dropdown-toggle.ed-topbar-link {
        display: inline-flex;
        align-items: center;
        gap: var(--ed-space-2);
        padding: 8px 12px;
        border-radius: var(--ed-radius-sm);
        color: var(--ed-on-dark);
        font-size: var(--ed-fs-base);
        font-weight: 500;
        text-decoration: none;
        background: transparent;
        border: 0;
        white-space: nowrap;
    }
    .ed-topbar .ed-topbar-link:hover,
    .ed-topbar .ed-topbar-link:focus,
    .ed-topbar .open > .ed-topbar-link { background: var(--ed-navy-2); color: var(--ed-on-dark); }
    .ed-topbar .dropdown-menu {
        right: 0;
        left: auto;
        min-width: 240px;
        margin-top: 6px;
        padding: var(--ed-space-1);
        background: var(--ed-surface);
        border: 1px solid var(--ed-border);
        border-radius: var(--ed-radius);
        box-shadow: var(--ed-shadow-lg);
    }
    .ed-topbar .dropdown-menu > li > a.list-group-item {
        display: flex;
        align-items: center;
        gap: var(--ed-space-2);
        width: auto;
        margin: 0;
        padding: 10px 12px;
        border: 0;
        border-radius: var(--ed-radius-sm);
        color: var(--ed-text);
        font-size: var(--ed-fs-base);
        background: transparent;
    }
    .ed-topbar .dropdown-menu > li > a.list-group-item:hover,
    .ed-topbar .dropdown-menu > li > a.list-group-item:focus { background: var(--ed-primary-soft); color: var(--ed-primary-hover); }
    .ed-topbar .dropdown-menu > li:empty { display: none; }

    /* ================= Shell: banners, breadcrumb, wizard ================= */
    .ed-env-banner {
        padding: 10px var(--ed-space-5);
        background: var(--ed-warning-soft);
        color: #533f03;
        border-bottom: 1px solid #f0d9a8;
        text-align: center;
        font-weight: 500;
    }
    #MVCSiteMap .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--ed-space-1);
        margin: 0;
        padding: 10px var(--ed-space-5);
        background: var(--ed-surface);
        border-bottom: 1px solid var(--ed-border);
        border-radius: 0;
        font-size: var(--ed-fs-sm);
        color: var(--ed-text-muted);
    }
    #MVCSiteMap .breadcrumb a { color: var(--ed-primary); }
    #MVCSiteMap #dvClose { margin-left: auto; }
    #MVCSiteMap #dvClose a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: var(--ed-radius-sm);
        color: var(--ed-text-muted);
        font-weight: 600;
        text-decoration: none;
    }
    #MVCSiteMap #dvClose a:hover { background: var(--ed-surface-2); color: var(--ed-text); }

    #UserEnromentWizard.breadcrumb {
        margin: 0;
        padding: var(--ed-space-4) var(--ed-space-5);
        background: var(--ed-surface);
        border-bottom: 1px solid var(--ed-border);
        border-radius: 0;
    }
    .ed-wizard-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--ed-space-4);
        max-width: var(--ed-content-max);
        margin: 0 auto;
    }
    .ed-wizard-heading { display: flex; flex-direction: column; min-width: 0; }
    .ed-wizard-eyebrow {
        font-size: var(--ed-fs-sm);
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--ed-text-muted);
    }
    #lblUserEnrolment { margin: 0; font-size: var(--ed-fs-lg); font-weight: 600; color: var(--ed-text); }
    .ed-steps { display: flex; align-items: center; gap: var(--ed-space-2); margin: 0; padding: 0; list-style: none; flex-wrap: wrap; }
    .ed-step { display: flex; align-items: center; gap: var(--ed-space-2); color: var(--ed-text-muted); font-size: var(--ed-fs-sm); font-weight: 600; }
    .ed-step + .ed-step::before { content: ""; width: 28px; height: 2px; background: var(--ed-border-strong); margin-right: var(--ed-space-1); }
    .ed-step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid var(--ed-border-strong);
        background: var(--ed-surface);
        font-size: var(--ed-fs-sm);
    }
    .ed-step.is-current { color: var(--ed-primary); }
    .ed-step.is-current .ed-step-num { border-color: var(--ed-primary); background: var(--ed-primary); color: var(--ed-on-dark); }
    .ed-step.is-done { color: var(--ed-success); }
    .ed-step.is-done .ed-step-num { border-color: var(--ed-success); background: var(--ed-success-soft); color: var(--ed-success); }
    .ed-step.is-done + .ed-step::before { background: var(--ed-success); }

    /* ================= Shell: main + status bar ================= */
    .ed-main { padding: var(--ed-space-5); }
    .ed-main > * { max-width: var(--ed-content-max); margin-left: auto; margin-right: auto; }

    footer.ed-statusbar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1020;
        height: var(--ed-statusbar-h);
        background: var(--ed-surface);
        border-top: 1px solid var(--ed-border);
        font-size: var(--ed-fs-sm);
        color: var(--ed-text-muted);
    }
    .ed-statusbar-inner { display: flex; align-items: center; gap: var(--ed-space-5); height: 100%; padding: 0 var(--ed-space-5); }
    .ed-statusbar .messagePanel { display: flex; align-items: center; gap: var(--ed-space-2); }
    .ed-statusbar .messagePanel img { width: 12px; height: 12px; }
    .ed-statusbar #ApplicationInfo { color: var(--ed-text); font-weight: 600; }
    .ed-statusbar-message { display: flex; align-items: center; gap: var(--ed-space-2); flex: 1; min-width: 0; }
    .ed-statusbar-message img { width: 18px; height: 18px; }
    .ed-statusbar #applicationMessage { font-size: var(--ed-fs-sm); color: var(--ed-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ed-statusbar-meta { display: flex; align-items: center; gap: var(--ed-space-4); margin-left: auto; white-space: nowrap; }
    .ed-statusbar #clock { font-family: var(--ed-font-mono); color: var(--ed-text); }

    /* ================= Busy overlay ================= */
    #divLoading.ed-busy { position: fixed; inset: 0; z-index: 30001; background: rgba(243, 245, 248, .9); }
    .ed-busy-card {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 480px;
        max-width: 90%;
        padding: 36px;
        text-align: center;
        background: var(--ed-surface);
        border-radius: var(--ed-radius-lg);
        box-shadow: var(--ed-shadow-lg);
        color: var(--ed-text);
    }
    .ed-busy-card h3 { margin-top: 0; }
    .edna-busy-spinner {
        width: 48px;
        height: 48px;
        margin: 0 auto 24px;
        border: 5px solid var(--ed-primary-soft);
        border-top-color: var(--ed-primary);
        border-radius: 50%;
        animation: edna-busy-spin 1s linear infinite;
    }
    @@keyframes edna-busy-spin { to { transform: rotate(360deg); } }
    @@media (prefers-reduced-motion: reduce) { .edna-busy-spinner { animation: none; } }

    /* ================= Bootstrap 3 overrides ================= */
    .btn {
        border-radius: var(--ed-radius-sm);
        font-weight: 600;
        padding: 9px 18px;
        font-size: var(--ed-fs-base);
        transition: background-color .15s, border-color .15s, box-shadow .15s;
    }
    .btn .glyphicon { margin-right: 4px; top: 2px; }
    .btn-lg { padding: 12px 24px; font-size: var(--ed-fs-lg); }
    .btn-primary { background: var(--ed-primary); border-color: var(--ed-primary); color: var(--ed-on-dark); }
    .btn-primary:hover, .btn-primary:focus, .btn-primary:active, .btn-primary.active { background: var(--ed-primary-hover); border-color: var(--ed-primary-hover); color: var(--ed-on-dark); }
    .btn-default { background: var(--ed-surface); border-color: var(--ed-border-strong); color: var(--ed-text); }
    .btn-default:hover, .btn-default:focus { background: var(--ed-surface-2); border-color: var(--ed-border-strong); color: var(--ed-text); }
    /* Secondary look for buttons that must keep the btn-primary class. */
    .btn.ed-btn-secondary { background: var(--ed-surface); border-color: var(--ed-border-strong); color: var(--ed-text); }
    .btn.ed-btn-secondary:hover, .btn.ed-btn-secondary:focus { background: var(--ed-surface-2); color: var(--ed-text); }
    .btn.ed-btn-success { background: var(--ed-success); border-color: var(--ed-success); color: var(--ed-on-dark); }
    .btn.ed-btn-success:hover, .btn.ed-btn-success:focus { filter: brightness(.92); color: var(--ed-on-dark); }
    .btn[disabled], .btn.disabled { opacity: .5; }

    .form-control {
        height: 40px;
        padding: 8px 12px;
        border: 1px solid var(--ed-border-strong);
        border-radius: var(--ed-radius-sm);
        box-shadow: none;
        font-size: var(--ed-fs-base);
        color: var(--ed-text);
    }
    textarea.form-control { height: auto; }
    .form-control:focus { border-color: var(--ed-focus); box-shadow: 0 0 0 3px rgba(43, 143, 224, .2); }
    .form-control[readonly] { background: var(--ed-surface-2); color: var(--ed-text-muted); }
    select.dropdown, select.dropdown-btn { height: 40px; padding: 6px 10px; border: 1px solid var(--ed-border-strong); border-radius: var(--ed-radius-sm); background: var(--ed-surface); color: var(--ed-text); }

    .table > thead > tr > th {
        background: var(--ed-surface-2);
        color: var(--ed-text-muted);
        font-size: var(--ed-fs-sm);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        border-bottom: 1px solid var(--ed-border);
    }
    .table > tbody > tr > td { border-top: 1px solid var(--ed-border); vertical-align: middle; }
    .table-hover > tbody > tr:hover { background: var(--ed-primary-soft); }

    .panel { border: 1px solid var(--ed-border); border-radius: var(--ed-radius); box-shadow: var(--ed-shadow-sm); }
    .alert { border-radius: var(--ed-radius); border-width: 1px; }
    .alert-info { background: var(--ed-primary-soft); border-color: #c9ddf0; color: #164e70; }
    .alert-success { background: var(--ed-success-soft); border-color: #bfe3cc; color: #1d5b39; }

    .tooltip-inner { background: var(--ed-navy); border-radius: var(--ed-radius-sm); padding: 6px 10px; }

    /* ================= Modals ================= */
    .modal-content { border: 0; border-radius: var(--ed-radius-lg); box-shadow: var(--ed-shadow-lg); }
    .modal-header { padding: var(--ed-space-4) var(--ed-space-5); border-bottom: 1px solid var(--ed-border); }
    .modal-header h4 { display: flex; align-items: center; gap: var(--ed-space-3); margin: 0; font-size: var(--ed-fs-lg); font-weight: 600; }
    .modal-header h4 img { width: 28px; height: auto; }
    .modal-body { padding: var(--ed-space-5); }
    .modal-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: var(--ed-space-2);
        padding: var(--ed-space-3) var(--ed-space-5);
        border-top: 1px solid var(--ed-border);
        background: var(--ed-surface-2);
        border-radius: 0 0 var(--ed-radius-lg) var(--ed-radius-lg);
    }
    .modal-footer .btn + .btn { margin-left: 0; }
    .modal-footer > img.pull-left { float: none !important; order: -1; margin-right: auto; height: 28px; width: auto; }
    .modal-dialog.ed-modal-md { width: 600px; max-width: calc(100% - 20px); }
    .modal-dialog.ed-modal-lg { width: 800px; max-width: calc(100% - 20px); }
    .modal-dialog.ed-modal-xl { width: 960px; max-width: calc(100% - 20px); }

    /* Message box */
    .ed-message-body label { display: block; float: none !important; margin: 0 0 var(--ed-space-2); font-weight: 400; }
    .ed-message-body #lblMessageHeader { font-size: var(--ed-fs-lg); font-weight: 600; }

    /* Key/value lists (user info, report error) */
    .ed-kv { display: grid; grid-template-columns: max-content 1fr; gap: var(--ed-space-2) var(--ed-space-5); margin: 0; }
    .ed-kv dt { color: var(--ed-text-muted); font-weight: 600; }
    .ed-kv dd { margin: 0; color: var(--ed-text); font-weight: 600; word-break: break-all; }
    .ed-kv dd label { font-weight: inherit; margin: 0; }

    /* Session countdown */
    .ed-countdown { text-align: center; }
    .ed-countdown #lblSessionTimer { display: block; font-size: var(--ed-fs-lg); font-weight: 500; margin-bottom: var(--ed-space-4); }
    .ed-countdown .thumbnail.wraptocenter {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 160px;
        height: 160px;
        margin: 0 auto;
        padding: 0;
        border: 6px solid var(--ed-primary-soft);
        border-radius: 50%;
        background: var(--ed-surface);
        box-shadow: none;
    }
    .ed-countdown #timespan { font-size: 48px; font-weight: 700; font-variant-numeric: tabular-nums; }

    /* Menu style chooser */
    .ed-option-grid { display: flex; gap: var(--ed-space-4); justify-content: center; flex-wrap: wrap; }
    .ed-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--ed-space-3);
        flex: 1 1 220px;
        padding: var(--ed-space-4);
        border: 1px solid var(--ed-border);
        border-radius: var(--ed-radius);
        background: var(--ed-surface);
        text-align: center;
    }
    .ed-option img { max-width: 100%; height: auto; border-radius: var(--ed-radius-sm); }
    .ed-option-title { font-weight: 600; }

    /* ================= Reusable page components ================= */
    .ed-page { display: flex; flex-direction: column; gap: var(--ed-space-5); }
    .panel-body.ed-page, .panel-body-details.ed-page { padding: 0; }
    .ed-page-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: var(--ed-space-4); }
    .ed-page-header h2, .ed-page-header h3 { margin: 0; font-size: var(--ed-fs-xl); }
    .ed-page-header p { margin: 4px 0 0; color: var(--ed-text-muted); }

    .ed-card {
        background: var(--ed-surface);
        border: 1px solid var(--ed-border);
        border-radius: var(--ed-radius);
        box-shadow: var(--ed-shadow-sm);
    }
    .ed-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ed-space-3);
        padding: var(--ed-space-4) var(--ed-space-5);
        border-bottom: 1px solid var(--ed-border);
    }
    .ed-card-header h3, .ed-card-header h4 { margin: 0; font-size: var(--ed-fs-lg); }
    .ed-card-body { padding: var(--ed-space-5); }
    .ed-card-body-compact { padding: var(--ed-space-4); }

    .ed-layout-split { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--ed-space-5); align-items: start; }
    .ed-grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ed-space-5); align-items: start; }

    .ed-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ed-space-4) var(--ed-space-5); }
    .ed-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .ed-field.ed-span-2 { grid-column: 1 / -1; }
    .ed-field > label { margin: 0; font-size: var(--ed-fs-sm); color: var(--ed-text-muted); }
    .ed-field .form-control, .ed-field select { width: 100% !important; }
    .ed-field-inline { flex-direction: row; align-items: center; gap: var(--ed-space-3); }
    .ed-field-inline input[type=checkbox] { width: 20px; height: 20px; margin: 0; }

    /* Restyles legacy Bootstrap horizontal rows (incl. rows injected at runtime) as label-above-field. */
    .ed-stacked-fields .form-group { display: flex; flex-direction: column; gap: 6px; margin: 0 0 var(--ed-space-4); }
    .ed-stacked-fields .form-group::before, .ed-stacked-fields .form-group::after { display: none; }
    .ed-stacked-fields .form-group > label { float: none; width: auto !important; margin: 0; padding: 0; text-align: left; font-size: var(--ed-fs-sm); color: var(--ed-text-muted); }
    .ed-stacked-fields .form-group > [class*="col-"] { float: none; width: auto !important; padding: 0; }
    .ed-stacked-fields .form-control { width: 100% !important; }
    .ed-userstatus { margin-top: var(--ed-space-4); padding-top: var(--ed-space-4); border-top: 1px solid var(--ed-border); }
    .ed-userform .ed-card { height: 100%; }

    .ed-searchbar { display: flex; align-items: center; gap: var(--ed-space-3); flex-wrap: wrap; }
    .ed-searchbar .form-group { margin: 0; }
    .ed-searchbar .form-control { width: 320px !important; max-width: 100%; }

    /* Sticky action bar for Cancel / Continue */
    .panel-footer.ed-actionbar, .ed-actionbar {
        position: sticky;
        bottom: calc(var(--ed-statusbar-h) + var(--ed-space-3));
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--ed-space-3);
        margin-top: var(--ed-space-5);
        padding: var(--ed-space-3) var(--ed-space-4);
        background: var(--ed-surface);
        border: 1px solid var(--ed-border);
        border-radius: var(--ed-radius);
        box-shadow: var(--ed-shadow);
    }
    .ed-actionbar-end { display: flex; align-items: center; gap: var(--ed-space-3); flex-wrap: wrap; }

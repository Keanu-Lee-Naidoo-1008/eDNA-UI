@*CODESC: Handles logout message.*@
<script type="text/javascript">
    function MyProfile() {
        $.ajax({
            type: "POST",
            dataType: "json",
            traditional: true,
            url: "UserProfile",
            data: JSON.stringify({ '': '' }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                //CODESC: Display busy process.
                ShowBusyProcessing();
                location = data;
            },
            error: function (data) {
                m_Logger.appendError(data);
            }
        });
        //CODESC: Display busy process.
        HideBusyProcessing();
    }
</script>


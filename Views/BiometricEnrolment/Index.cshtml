@{
    ViewBag.Title = "Biometric Enrolment Details";
}
<input type="hidden" id="RequiredFingerprintCount" value="@ViewBag.RequiredFingerprintCount" />
@if (Convert.ToString(HttpContext.Current.Session["Modality_Type"]) == "FingerPrint")
{
    <div class="ed-page-header ed-page-intro">
        <div>
            <h2>Fingerprint enrolment</h2>
            <p>Capture @ViewBag.RequiredFingerprintCount different fingers, with two samples of each finger, then verify and sign to continue.</p>
        </div>
        <ol class="ed-checklist" aria-label="Fingerprint steps">
            <li>Click a finger to capture it twice</li>
            <li>Verify all captured fingers</li>
            <li>Sign and continue</li>
        </ol>
    </div>
}
@if (Convert.ToString(HttpContext.Current.Session["Modality_Type"]) == "Selection")
{
    <div class="panel-body-details ed-page">
        <div class="ed-page-header">
            <div>
                <h2>Select Biometric Enrolment Type</h2>
                <p>Please select the biometric modality to enrol for this user.</p>
            </div>
        </div>
        <div class="ed-choice-grid">
            @if (ViewBag.FingerprintAvailable == true)
            {
                <a href="@Url.Action("Index", "BiometricEnrolment", new { p_strModality = "Fingerprint" })"
                   class="btn btn-primary ed-choice"
                   title="Continue to fingerprint enrolment">
                    <span class="glyphicon glyphicon-hand-up ed-choice-icon"></span>
                    <span class="ed-choice-title">Fingerprint Enrolment</span>
                    <span class="ed-choice-text">Capture two samples of each required finger with the fingerprint scanner.</span>
                </a>
            }
            @if (ViewBag.FacialAvailable == true)
            {
                <a href="@Url.Action("Index", "BiometricEnrolment", new { p_strModality = "Facial" })"
                   class="btn btn-primary ed-choice"
                   title="Continue to facial enrolment">
                    <span class="glyphicon glyphicon-user ed-choice-icon"></span>
                    <span class="ed-choice-title">Facial Enrolment</span>
                    <span class="ed-choice-text">Capture and verify three face images with the camera.</span>
                </a>
            }
        </div>
    </div>
    <div class="panel-footer ed-actionbar">
        <a href="@Url.Action("Index", "UserEnrolment")" class="btn btn-primary ed-btn-secondary"
           title="Cancel the enrolment process">
            <span class="glyphicon glyphicon-remove"></span> Cancel
        </a>
    </div>
}

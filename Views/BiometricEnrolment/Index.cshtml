{
    <div class="panel-body-details face-enrolment-panel ed-page">
        <div class="face-enrolment-header ed-page-header">
            <div>
                <h3>Facial Enrolment</h3>
                <p>Capture and verify three facial images using the secure Identity Management application.</p>
            </div>
            <div class="ed-actionbar-end">
                <a href="javascript:ClearFacePrints()" class="btn btn-default btn-lg" data-toggle="tooltip" title="Discard all captured face images">
                    <span class="glyphicon glyphicon-refresh"></span> Reset
                </a>
                <button type="button" id="lnkCFace" class="btn btn-primary btn-lg face-capture-button"
                        onclick="CaptureFace('Face')" data-toggle="tooltip" title="Open secure facial capture">
                    <span class="glyphicon glyphicon-camera"></span> Capture Face Images
                </button>
            </div>
        </div>

        <ol class="ed-checklist ed-checklist-wide" aria-label="Facial enrolment steps">
            <li><strong>Capture</strong> opens the eDNA Facial Capture window. Position the face inside the oval guide.</li>
            <li><strong>Process</strong> each image in the capture window so it is verified and returned here.</li>
            <li><strong>Sign and continue</strong> once all three images show as captured.</li>
        </ol>

        <div class="face-image-grid" aria-label="Captured facial images">
            @for (Int32 l_iFaceImage = 1; l_iFaceImage <= 3; l_iFaceImage++)
            {
                <div class="face-image-card">
                    <div class="face-image-number">Image @l_iFaceImage</div>
                    <canvas id="@("imgFace" + l_iFaceImage)" class="face-capture-image"
                            width="320" height="240"
                            data-placeholder-src="@Url.Content("~/Content/Images/Enrolment/Facial.jpg")"
                            style="background-image:url('@Url.Content("~/Content/Images/Enrolment/Facial.jpg")')"
                            role="img" aria-label="@("Facial enrolment wireframe placeholder for image " + l_iFaceImage)"></canvas>
                    <div id="@("lblFaceImageQuality" + l_iFaceImage)" class="face-image-quality">Not captured</div>
                </div>
            }
        </div>
    </div>
    <div class="panel-footer ed-actionbar">
        <a href="@Url.Action("Index","UserEnrolment")" class="btn btn-primary ed-btn-secondary" data-toggle="tooltip" title="Cancel the Enrolment Process"><span class="glyphicon glyphicon-remove"></span> Cancel</a>
        <a href="javascript:BiometricFacialSave()" class="btn btn-primary" data-toggle="tooltip" title="Sign the verified facial enrolment and continue"><span class="glyphicon glyphicon-hand-up"></span> Sign And Continue</a>
    </div>

    <input type="hidden" id="FaceNo" />

}

@*CODESC: Hide MVC SiteMap/Breadcrumb and display Enrolment div to not allow user clicks in the Sitemap while busy with enrolment process.*@
<script type="text/javascript">
    $(document).ready(function () {

        if ($('#FaceNo').length > 0) {
            LogFacePreviewTrace('DocumentReady', 'Url=' + window.location.href + ';NavigationType=' +
                (window.performance && window.performance.navigation ? window.performance.navigation.type : 'Unavailable'));

            window.addEventListener('beforeunload', function () {
                if (navigator.sendBeacon) {
                    var l_FormData = new FormData();
                    l_FormData.append('p_strEvent', 'BeforeUnload');
                    l_FormData.append('p_strDetails', 'Url=' + window.location.href);
                    navigator.sendBeacon('/eDNA.WebPortal/BiometricEnrolment/LogFacePreviewTrace', l_FormData);
                }
            });
        }

        var l_strFacialPreviewImages = sessionStorage.getItem('FacialPreviewImages');
        if ($('#FaceNo').length > 0 && l_strFacialPreviewImages != null) {
            try {
                BindFaceImages(JSON.parse(l_strFacialPreviewImages));
                $('#lnkCFace').prop('disabled', true).attr('aria-disabled', 'true');
            }
            catch (p_Exception) {
                sessionStorage.removeItem('FacialPreviewImages');
            }
        }

        //document.getElementById("MVCSiteMap").style.display = "none";
        $("#UserEnromentWizard").show();
        //To disable a link.
        //$("#lnkCFinger1").hide();
        //$('#lnkCFinger1').attr("href", "javascript: void(0)");
        //$("#lnkCFinger6").hide();
        //$('#lnkCFinger6').attr("href", "javascript: void(0)");

        if (localStorage.getItem("m_isUserUpdate") == 'CrOrUpd') {
            Notify("User Enrolment" + "<br>", "User details captured successfully. Continue with Biometric Enrolment.");
        }
    });
</script>

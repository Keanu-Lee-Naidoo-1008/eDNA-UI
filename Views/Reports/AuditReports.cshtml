@*CODESC: SwitchOn/Off Timer and Countdown for the autorefresh the job list table*@
<script type="text/javascript">
    var l_CountTime;
    var l_TimeOut, l_TimeLeft;
    var l_color = 'green';
    var l_clMagenta = 'magenta';
    var l_clOrangered = 'orangered';
    var l_clRed = 'red';
    var l_clGrey = 'grey';
    var l_clBlue = 'blue';

    //CODESC: SwitchOn/Off Timer
    function SwitchOn() {
        if ($('#auditAutoRefresh').prop('checked')) {
            m_AutoRefresh = "On";
            $("#lblTimer").show();
            l_CountTime = 15;
            ResetTimer();
        }
        else {
            $("#lblTimer").hide();
            m_AutoRefresh = "";
            PauseTimer();
        }
    }

    //CODESC: Update display Time value
    function UpdateDisplay(p_Color) {
        document.getElementById('timespan').innerHTML = l_TimeLeft;
        document.getElementById('timespan').style.color = p_Color;
    }

    //CODESC: Start Countdown
    function CountDown() {
        UpdateDisplay(l_clBlue);
        if (l_TimeLeft >= 0) {
            if (l_TimeLeft > 5 && l_TimeLeft < 10) {
                UpdateDisplay(l_clMagenta);
            }
            if (l_TimeLeft > 10 && l_TimeLeft < 15) {
                UpdateDisplay(l_clOrangered);
            }
            if (l_TimeLeft > 15 && l_TimeLeft < 20) {
                UpdateDisplay(l_clRed);
            }
            if (l_TimeLeft > 20 && l_TimeLeft < 25) {
                UpdateDisplay(l_clGrey);
            }
            if (l_TimeLeft > 25 && l_TimeLeft < 30) {
                UpdateDisplay(l_clBlue);
            }
        }
        if (l_TimeLeft === 0) {
            // time is up
            if (m_AutoRefresh == "On") {
                // Do not interrupt an active biometric transaction with background polling.
                if (!forensicReviewPending && !forensicRetrievalPending && !$('#divLoading').is(':visible'))
                    AuditJobList();
            }
            ResetTimer();
        }
        else {
            l_TimeLeft--;
            l_TimeOut = setTimeout(CountDown, 1000);
        }
    }

    //CODESC: Pauses Countdown
    function PauseTimer() {
        clearTimeout(l_TimeOut);
    }

    //CODESC: Reset Countdown
    function ResetTimer() {
        PauseTimer();
        l_TimeLeft = l_CountTime;
        UpdateDisplay(l_clBlue);
        CountDown();
    }
</script>

@*CODESC: Manage Filter DateTimePicker control*@
<script type="text/javascript">
    $(function () {
        $('#dtAuditFilterSDateTime').datetimepicker({
            sideBySide: true,
            showClose: true,
            format: 'YYYY-MM-DD HH:mm:00',

        });
        $('#dtAuditFilterEDateTime').datetimepicker({
            sideBySide: true,
            showClose: true,
            useCurrent: false,
            format: 'YYYY-MM-DD HH:mm:00',
        });
        $("#dtAuditFilterSDateTime").on("dp.change", function (e) {
            $('#dtAuditFilterEDateTime').data("DateTimePicker").minDate(e.date);
            $('#dtAuditFilterSDateTime').data("DateTimePicker").hide();
        });
        $("#dtAuditFilterEDateTime").on("dp.change", function (e) {
            $('#dtAuditFilterSDateTime').data("DateTimePicker").maxDate(e.date);
            $('#dtAuditFilterEDateTime').data("DateTimePicker").hide();
        });
    });

</script>

@*CODESC: Display and Hide Advanced Filter Panel*@
<script type="text/javascript">
    function ShowFilter() {
        if (document.getElementById('spnFilter').title != "Close Advanced Filter") {

            $("#tblAdvancedFilter").show();
            document.getElementById('spnFilter').title = "Close Advanced Filter";
        }
        else {
            ResetAuditFilter();
            $("#tblAdvancedFilter").hide();
            document.getElementById('spnFilter').innerHTML = "AdvancedFilter";
            document.getElementById('spnFilter').title = "Show Advanced Filter";
        }
    }
</script>
